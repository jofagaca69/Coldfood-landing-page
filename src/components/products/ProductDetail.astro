---
import type { Product } from '@/data/products';
import { getProductsByCategory } from '@/data/products';
import { CATEGORIES } from '@/data/categories';
import { CONTACT, getWhatsAppUrl } from '@/data/contact';
import type { Locale } from '@/consts';
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import Breadcrumbs from './Breadcrumbs.astro';
import ProductGallery from './ProductGallery.astro';
import ProductCard from './ProductCard.astro';
import { FORMAT_ICONS } from './format-icons';

/**
 * Cuerpo completo de una ficha de producto (/productos/<slug>/). Compartido
 * por las dos rutas dinámicas por idioma (src/pages/productos/[slug].astro y
 * src/pages/en/productos/[slug].astro) para no duplicar el markup.
 */
interface Props {
	product: Product;
	locale: Locale;
}

const { product, locale } = Astro.props;
const t = useTranslations(locale);
const copy = product[locale];

const category = CATEGORIES.find((c) => c.slug === product.categorySlug)!;
const productsPath = getLocalizedPath('/productos/', locale);

const related = getProductsByCategory(product.categorySlug)
	.filter((p) => p.slug !== product.slug)
	.slice(0, 3);

const whatsappHref = getWhatsAppUrl(t('whatsapp.message'), CONTACT.whatsapp);
---

<main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
	<Breadcrumbs
		items={[
			{ label: t('nav.home'), href: getLocalizedPath('/', locale) },
			{ label: t('products.breadcrumb.products'), href: productsPath },
			{ label: category[locale], href: `${productsPath}#${category.slug}` },
			{ label: copy.name },
		]}
	/>

	<div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:gap-14">
		<ProductGallery product={product} locale={locale} />

		<div>
			<a href={`${productsPath}#${category.slug}`} class="text-sm font-semibold text-primary hover:underline">
				{category[locale]}
			</a>
			<h1 class="mt-2 font-display text-3xl leading-[1.1] font-normal text-ink sm:text-4xl">{copy.name}</h1>
			<p class="mt-4 max-w-[52ch] text-base text-ink-muted sm:text-lg">{copy.shortDescription}</p>

			{
				copy.features.length > 0 && (
					<ul class="mt-5 flex flex-wrap gap-2">
						{copy.features.map((feature) => (
							<li class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-800 ring-1 ring-green-200">
								{feature}
							</li>
						))}
					</ul>
				)
			}

			<div class="mt-7 flex flex-wrap items-center gap-3">
				<a
					href={getLocalizedPath('/contacto/', locale)}
					class="inline-flex items-center gap-2 rounded-full bg-cta px-6 py-3 text-sm font-semibold whitespace-nowrap text-white hover:bg-cta-hover sm:text-base"
				>
					{t('hero.cta.primary')}
					<svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
				<a
					href={whatsappHref}
					target="_blank"
					rel="noopener"
					class="inline-flex items-center gap-2 rounded-full border border-line-strong px-6 py-3 text-sm font-semibold whitespace-nowrap text-ink hover:bg-surface-muted sm:text-base"
				>
					<svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.83 9.83 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.478-8.413"
						/>
					</svg>
					{t('cta.whatsapp')}
				</a>
			</div>
		</div>
	</div>

	<section class="mt-14 max-w-[70ch] border-t border-line pt-10">
		<p class="text-base text-ink-muted sm:text-lg">{copy.longDescription}</p>
	</section>

	<section class="mt-14 border-t border-line pt-10">
		<h2 class="font-display text-2xl font-normal text-ink">{t('products.detail.variants.title')}</h2>
		<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
			{
				product.variants.map((variant) => {
					const icon = FORMAT_ICONS[variant.format];
					return (
						<div class="flex items-center gap-4 rounded-xl border border-line p-4">
							<svg class="h-9 w-9 shrink-0 text-brown-600" viewBox={icon.viewBox} fill="none" aria-hidden="true">
								{icon.paths.map((d) => (
									<path d={d} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
								))}
							</svg>
							<div class="min-w-0">
								<p class="font-semibold text-ink">{variant[locale].presentation}</p>
								<p class="text-sm text-ink-muted">{variant[locale].packing}</p>
							</div>
						</div>
					);
				})
			}
		</div>
	</section>

	{
		related.length > 0 && (
			<section class="mt-14 border-t border-line pt-10">
				<h2 class="font-display text-2xl font-normal text-ink">{t('products.detail.related.title')}</h2>
				<div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{related.map((p) => (
						<ProductCard product={p} locale={locale} />
					))}
				</div>
			</section>
		)
	}

	<div class="mt-14 border-t border-line pt-8">
		<a href={productsPath} class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
			<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
				<path d="M12.5 15 7.5 10l5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			{t('products.detail.back')}
		</a>
	</div>
</main>
