---
import type { Product } from '@/data/products';
import { getProductsByCategory, LOAD_CONFIGS } from '@/data/products';
import { CATEGORIES } from '@/data/categories';
import { CONTACT, getWhatsAppUrl } from '@/data/contact';
import type { Locale } from '@/consts';
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import Breadcrumbs from './Breadcrumbs.astro';
import ProductGallery from './ProductGallery.astro';
import ProductCard from './ProductCard.astro';
import { FORMAT_ICONS } from './format-icons';

/**
 * Cuerpo completo de una ficha de producto (/productos/<slug>/). Compartido
 * por las dos rutas dinámicas por idioma (src/pages/productos/[slug].astro y
 * src/pages/en/productos/[slug].astro) para no duplicar el markup.
 */
interface Props {
	product: Product;
	locale: Locale;
}

const { product, locale } = Astro.props;
const t = useTranslations(locale);
const copy = product[locale];

const category = CATEGORIES.find((c) => c.slug === product.categorySlug)!;
const productsPath = getLocalizedPath('/productos/', locale);

const related = getProductsByCategory(product.categorySlug)
	.filter((p) => p.slug !== product.slug)
	.slice(0, 3);

// Un solo eje de variación (presentación / tamaño de empaque). Con una sola
// variante no hay nada que elegir: se muestra estática, sin chrome de switcher.
const variants = product.variants;
const canSwitchVariant = variants.length > 1;
const firstVariantIcon = FORMAT_ICONS[variants[0].format];

// Variante → índice de la foto de galería que la ilustra (solo pulpas traen
// `variantIds`; el resto de productos tiene una sola foto y no reacciona al
// cambio de variante). Usado para sincronizar el switcher con la imagen
// principal sin duplicar la lógica de miniaturas de ProductGallery.astro.
const galleryIndexByVariant = new Map<string, number>();
product.gallery.forEach((img, i) => {
	img.variantIds?.forEach((id) => {
		if (!galleryIndexByVariant.has(id)) galleryIndexByVariant.set(id, i);
	});
});

const whatsappHref = getWhatsAppUrl(t('whatsapp.message'), CONTACT.whatsapp);
---

<main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
	<Breadcrumbs
		items={[
			{ label: t('nav.home'), href: getLocalizedPath('/', locale) },
			{ label: t('products.breadcrumb.products'), href: productsPath },
			{ label: category[locale], href: `${productsPath}#${category.slug}` },
			{ label: copy.name },
		]}
	/>

	<div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:gap-14">
		<ProductGallery product={product} locale={locale} />

		<div>
			<a href={`${productsPath}#${category.slug}`} class="text-sm font-semibold text-primary hover:underline">
				{category[locale]}
			</a>
			<h1 class="mt-2 font-display text-3xl leading-[1.1] font-bold text-ink sm:text-4xl">{copy.name}</h1>
			<p class="mt-4 max-w-[52ch] text-base text-ink-muted sm:text-lg">{copy.shortDescription}</p>

			<div class="mt-6">
				<p id="variant-size-label" class="text-xs font-semibold tracking-[0.16em] text-ink-muted uppercase">
					{t('products.detail.variants.presentation')}
				</p>

				{
					canSwitchVariant ? (
						<div class="mt-2.5 flex flex-wrap gap-2" role="group" aria-labelledby="variant-size-label">
							{variants.map((variant, i) => (
								<button
									type="button"
									data-variant-pill
									data-variant-row="presentation"
									data-variant-id={variant.id}
									data-gallery-index={galleryIndexByVariant.get(variant.id)}
									data-active={i === 0 ? 'true' : 'false'}
									aria-pressed={i === 0 ? 'true' : 'false'}
									class="max-w-full cursor-pointer rounded-xl border border-line bg-surface px-4 py-2 text-left text-sm leading-snug font-medium text-ink transition-colors hover:border-line-strong hover:bg-surface-muted data-[active=false]:bg-surface-muted data-[active=false]:text-ink-muted data-[active=true]:border-primary data-[active=true]:text-primary data-[active=true]:ring-1 data-[active=true]:ring-primary"
								>
									{variant[locale].presentation}
								</button>
							))}
						</div>
					) : (
						<p class="mt-2.5 inline-block max-w-full rounded-xl border border-line bg-surface-muted px-4 py-2 text-sm leading-snug font-medium text-ink">
							{variants[0][locale].presentation}
						</p>
					)
				}
			</div>

			<div class="mt-4">
				<p id="variant-box-label" class="text-xs font-semibold tracking-[0.16em] text-ink-muted uppercase">
					{t('products.detail.variants.packing')}
				</p>

				{
					canSwitchVariant ? (
						<Fragment>
							<div class="mt-2.5 flex flex-wrap gap-2" role="group" aria-labelledby="variant-box-label">
								{variants.map((variant, i) => {
									const icon = FORMAT_ICONS[variant.format];
									return (
										<button
											type="button"
											data-variant-pill
											data-variant-row="packing"
											data-variant-id={variant.id}
											data-gallery-index={galleryIndexByVariant.get(variant.id)}
											data-active={i === 0 ? 'true' : 'false'}
											aria-pressed={i === 0 ? 'true' : 'false'}
											class="group inline-flex max-w-full cursor-pointer items-center gap-2 rounded-xl border border-line bg-surface px-4 py-2 text-left text-sm leading-snug font-medium text-ink transition-colors hover:border-line-strong hover:bg-surface-muted data-[active=false]:bg-surface-muted data-[active=false]:text-ink-muted data-[active=true]:border-primary data-[active=true]:text-primary data-[active=true]:ring-1 data-[active=true]:ring-primary"
										>
											<svg
												class="h-5 w-5 shrink-0 text-brown-600 group-data-[active=false]:text-ink-muted"
												viewBox={icon.viewBox}
												fill="none"
												aria-hidden="true"
											>
												{icon.paths.map((d) => (
													<path d={d} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
												))}
											</svg>
											{variant[locale].packing}
										</button>
									);
								})}
							</div>
							<p class="sr-only" role="status" data-variant-announce></p>
						</Fragment>
					) : (
						<p class="mt-2.5 inline-flex max-w-full items-center gap-2 rounded-xl border border-line bg-surface-muted px-4 py-2 text-sm leading-snug font-medium text-ink">
							<svg class="h-5 w-5 shrink-0 text-brown-600" viewBox={firstVariantIcon.viewBox} fill="none" aria-hidden="true">
								{firstVariantIcon.paths.map((d) => (
									<path d={d} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
								))}
							</svg>
							{variants[0][locale].packing}
						</p>
					)
				}
			</div>

			{
				copy.features.length > 0 && (
					<ul class="mt-5 flex flex-wrap gap-2">
						{copy.features.map((feature) => (
							<li class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-800 ring-1 ring-green-200">
								{feature}
							</li>
						))}
					</ul>
				)
			}

			<div class="mt-7 flex flex-wrap items-center gap-3">
				<a
					href={getLocalizedPath('/contacto/', locale)}
					class="inline-flex items-center gap-2 rounded-full bg-cta px-6 py-3 text-sm font-semibold whitespace-nowrap text-white hover:bg-cta-hover sm:text-base"
				>
					{t('hero.cta.primary')}
					<svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
				<a
					href={whatsappHref}
					target="_blank"
					rel="noopener"
					class="inline-flex items-center gap-2 rounded-full border border-line-strong px-6 py-3 text-sm font-semibold whitespace-nowrap text-ink hover:bg-surface-muted sm:text-base"
				>
					<svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.83 9.83 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.478-8.413"
						/>
					</svg>
					{t('cta.whatsapp')}
				</a>
			</div>
		</div>
	</div>

	<section class="mt-14 max-w-[70ch] border-t border-line pt-10">
		<p class="text-base text-ink-muted sm:text-lg">{copy.longDescription}</p>
		<p class="mt-6 text-xs font-semibold tracking-[0.16em] text-ink-muted uppercase">
			{t('products.detail.usage.title')}
		</p>
		<p class="mt-2 text-base text-ink-muted sm:text-lg">{category.usage[locale]}</p>
	</section>

	<section class="mt-10 max-w-[70ch] border-t border-line pt-10">
		<h2 class="font-display text-2xl font-semibold text-ink">{t('products.detail.specs.title')}</h2>
		<dl class="mt-6 divide-y divide-line border-y border-line text-sm sm:text-base">
			{
				variants.map((variant) => (
					<div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-[1fr_2fr] sm:gap-4">
						<dt class="font-semibold text-ink">{variant[locale].presentation}</dt>
						<dd class="text-ink-muted">
							{t('products.detail.specs.netWeight')}: {variant.netWeightG} g
							{variant.drainedWeightG && (
								<>
									{' '}
									· {t('products.detail.specs.drainedWeight')}: {variant.drainedWeightG} g
								</>
							)}
							{' · '}
							{t('products.detail.specs.unitsPerBox')}: {variant.unitsPerBox}
							{' · '}
							{t('products.detail.specs.pallet')}: {LOAD_CONFIGS[variant.loadConfigId][locale].label}
						</dd>
					</div>
				))
			}
			<div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-[1fr_2fr] sm:gap-4">
				<dt class="font-semibold text-ink">{t('products.detail.specs.storage.title')}</dt>
				<dd class="text-ink-muted">{t('products.detail.specs.storage.value')}</dd>
			</div>
		</dl>
	</section>

	{
		related.length > 0 && (
			<section class="mt-14 border-t border-line pt-10">
				<h2 class="font-display text-2xl font-semibold text-ink">{t('products.detail.related.title')}</h2>
				<div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{related.map((p) => (
						<ProductCard product={p} locale={locale} />
					))}
				</div>
			</section>
		)
	}

	<div class="mt-14 border-t border-line pt-8">
		<a href={productsPath} class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline">
			<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
				<path d="M12.5 15 7.5 10l5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			{t('products.detail.back')}
		</a>
	</div>
</main>

<script>
	// Dos filas de píldoras (presentación individual / presentación en caja)
	// representan la MISMA lista de variantes — cada variante tiene una única
	// presentación y una única caja asociadas (src/data/products.ts). Por eso
	// comparten una sola selección: elegir una píldora en cualquiera de las
	// dos filas activa, en ambas filas, la que comparta su `data-variant-id`,
	// evitando combinaciones inexistentes (p. ej. "100 g" con "6 Und x Caja").
	// Mismo patrón que las miniaturas de ProductGallery.astro (data-attributes
	// + querySelectorAll, sin framework).
	const variantPills = document.querySelectorAll<HTMLButtonElement>('[data-variant-pill]');
	const variantAnnounce = document.querySelector<HTMLElement>('[data-variant-announce]');

	function selectVariant(variantId: string) {
		let presentation = '';
		let packing = '';

		variantPills.forEach((p) => {
			const active = p.dataset.variantId === variantId;
			p.setAttribute('data-active', active ? 'true' : 'false');
			p.setAttribute('aria-pressed', active ? 'true' : 'false');
			if (!active) return;
			if (p.dataset.variantRow === 'presentation') presentation = p.textContent?.trim() ?? '';
			else packing = p.textContent?.trim() ?? '';
		});

		// La foto principal sigue a la variante seleccionada reutilizando el
		// mismo clic que dispara la miniatura correspondiente (ver
		// ProductGallery.astro), que ya limpia srcset/sizes al cambiar de
		// imagen. Solo aplica a productos con foto por presentación (pulpas).
		const pillWithImage = document.querySelector<HTMLButtonElement>(
			`[data-variant-pill][data-variant-id="${variantId}"][data-gallery-index]`,
		);
		const galleryIndex = pillWithImage?.dataset.galleryIndex;
		if (galleryIndex !== undefined) {
			document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')[Number(galleryIndex)]?.click();
		}

		if (variantAnnounce) variantAnnounce.textContent = [presentation, packing].filter(Boolean).join(' — ');
	}

	variantPills.forEach((pill) => {
		pill.addEventListener('click', () => selectVariant(pill.dataset.variantId!));
	});
</script>
