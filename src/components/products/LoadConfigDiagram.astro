---
import type { LoadConfig } from '@/data/products';
import type { Locale } from '@/consts';
import { useTranslations } from '@/i18n/utils';

/**
 * Elemento de firma de la ficha de producto: redibuja la configuración de
 * carga (vista superior + vista frontal) que trae el catálogo del cliente,
 * como CSS puro en vez de una captura del PDF. Los números vienen 1:1 de
 * `LOAD_CONFIGS` (src/data/products.ts) — nada aquí es decorativo inventado.
 */
interface Props {
	config: LoadConfig;
	locale: Locale;
}

const { config, locale } = Astro.props;
const t = useTranslations(locale);
const copy = config[locale];

const verticalBoxes = Array.from({ length: config.layout.verticalBoxes });
const horizontalBoxes = Array.from({ length: config.layout.horizontalBoxes });
const layers = Array.from({ length: config.layers });
---

<div class="grid gap-8 sm:grid-cols-2">
	<!-- Vista superior: cajas verticales + horizontales de un piso -->
	<div>
		<p class="text-xs font-semibold tracking-wide text-ink-subtle uppercase">{t('products.detail.loadConfig.topView')}</p>
		<div class="mt-3 flex flex-wrap items-end gap-1.5 rounded-xl border border-line bg-surface-muted p-4">
			{
				verticalBoxes.map(() => (
					<div class="h-14 w-6 rounded-[3px] border border-brown-500 bg-brown-200" aria-hidden="true" />
				))
			}
			{
				horizontalBoxes.map(() => (
					<div class="h-6 w-14 rounded-[3px] border border-brown-500 bg-brown-100" aria-hidden="true" />
				))
			}
		</div>
		<p class="mt-2 text-sm text-ink-muted">{copy.topView}</p>
	</div>

	<!-- Vista frontal: pisos de alto -->
	<div>
		<p class="text-xs font-semibold tracking-wide text-ink-subtle uppercase">{t('products.detail.loadConfig.frontView')}</p>
		<div class="mt-3 flex flex-col-reverse gap-[3px] rounded-xl border border-line bg-surface-muted p-4">
			{
				layers.map((_, i) => (
					<div
						class="h-3 w-full rounded-[2px] border border-brown-500"
						style={`background-color: color-mix(in oklch, var(--color-brown-200) ${100 - i * 4}%, var(--color-brown-400))`}
						aria-hidden="true"
					/>
				))
			}
		</div>
		<p class="mt-2 text-sm text-ink-muted">{copy.frontView}</p>
	</div>
</div>
