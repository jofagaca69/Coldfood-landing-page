---
import { Image } from 'astro:assets';
import banner from '@/assets/banner2.webp';
import { getLocalizedPath, resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const features = [
	{ label: t('hero.feature.natural'), icon: 'M12 3c-1.5 3-6 4.5-6 9.5A6 6 0 0 0 12 18a6 6 0 0 0 6-5.5C18 7.5 13.5 6 12 3Z' },
	{ label: t('hero.feature.frozen'), icon: 'M10 2v16M10 2 6.5 5.5M10 2l3.5 3.5M10 18l-3.5-3.5M10 18l3.5-3.5M2 10h16M2 10l3.5-3.5M2 10l3.5 3.5M18 10l-3.5-3.5M18 10l-3.5 3.5' },
	{ label: t('hero.feature.flavor'), icon: 'M5 20c7-1.5 12-8 14-16-8 2.5-13.5 8-14 16Z M7 14c3-2 7-4.5 12-6' },
	{ label: t('hero.feature.markets'), icon: 'M10 2.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Zm0 0c1.8 1.9 2.8 4.4 2.8 7.5s-1 5.6-2.8 7.5m0-15c-1.8 1.9-2.8 4.4-2.8 7.5s1 5.6 2.8 7.5M2.8 10h14.4' },
] as const;
---

<section class="relative overflow-hidden bg-canvas">
	<div class="relative flex flex-col lg:block lg:aspect-[2048/768] lg:min-h-[30rem]">
				<div class="relative z-10 order-2 mx-auto w-full max-w-7xl px-4 pt-6 pb-8 sm:px-6 sm:py-8 lg:absolute lg:inset-0 lg:flex lg:items-center lg:px-8 lg:py-0">
					<div class="max-w-[36rem]">
						<h1 class="hero-title font-display text-[2.1rem] leading-[1.1] font-bold tracking-tight sm:text-4xl lg:text-[3rem]">
							<span class="hero-title-line block overflow-hidden">
								<span class="hero-title-inner block text-ink">{t('hero.title.a')}</span>
							</span>
							<span class="hero-title-line block overflow-hidden">
								<span class="hero-title-inner block text-primary">{t('hero.title.b')}</span>
							</span>
						</h1>

						<p class="hero-reveal mt-4 inline-flex items-center gap-2 font-display text-lg font-semibold text-ink sm:text-xl">
							{t('hero.tagline')}
							<span class="h-1.5 w-10 rounded-full bg-accent" aria-hidden="true" />
						</p>

						<p class="hero-reveal mt-4 max-w-[46ch] text-base text-ink-muted sm:text-lg">{t('hero.subtitle')}</p>

						<div class="hero-reveal mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center lg:mt-7">
							<a
								href={getLocalizedPath('/productos/', locale)}
								class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold whitespace-nowrap text-white hover:bg-primary-hover sm:text-base"
							>
								{t('hero.cta.products')}
								<svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
									<path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
							<a
								href={getLocalizedPath('/contacto/', locale)}
								class="inline-flex items-center justify-center gap-2 rounded-full border border-line-strong bg-surface px-6 py-3 text-sm font-semibold whitespace-nowrap text-ink hover:bg-canvas sm:text-base"
							>
								{t('hero.cta.primary')}
							</a>
						</div>

						<ul class="hero-reveal mt-6 grid grid-cols-2 gap-x-4 gap-y-3 lg:mt-8">
							{features.map((feature) => (
								<li class="flex items-center gap-2 text-xs font-semibold text-ink sm:text-sm">
									<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
										<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
											<path d={feature.icon} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</span>
									{feature.label}
								</li>
							))}
						</ul>
					</div>
				</div>

				<div class="relative order-1 aspect-[16/10] w-full sm:aspect-[16/9] lg:absolute lg:inset-0 lg:aspect-auto">
					<Image
						src={banner}
						alt={t('hero.banner.alt')}
						widths={[640, 960, 1440, 2048]}
						sizes="100vw"
						loading="eager"
						fetchpriority="high"
						class="h-full w-full object-cover object-center"
					/>
					{/* Panel difuminado (frosted glass) solo detrás del bloque de texto: la imagen se ve completa y nítida en el resto del banner. */}
					<div
						class="pointer-events-none absolute inset-y-0 left-0 hidden w-[62%] backdrop-blur-md [-webkit-mask-image:linear-gradient(to_right,black_0%,black_60%,transparent_100%)] [mask-image:linear-gradient(to_right,black_0%,black_60%,transparent_100%)] lg:block"
						aria-hidden="true"
					/>
					<div
						class="pointer-events-none absolute inset-y-0 left-0 hidden w-[66%] bg-gradient-to-r from-canvas/80 via-canvas/55 to-transparent lg:block"
						aria-hidden="true"
					/>
				</div>
			</div>
</section>

<script is:inline>
	if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
		document.documentElement.dataset.heroAnim = 'on';
	}
</script>

<script>
	import '@/scripts/hero-animation';
</script>

<style>
	:global(:root[data-hero-anim='on']) .hero-title-inner,
	:global(:root[data-hero-anim='on']) .hero-reveal {
		opacity: 0;
	}
</style>
