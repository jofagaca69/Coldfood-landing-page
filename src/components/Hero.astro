---
import { Image } from 'astro:assets';
import banner from '@/assets/banner.png';
import bannerEnglish from '@/assets/BANNER INGLES.png';
import bannerPack from '@/assets/BANNER EMPAQUE.png';
import bannerPackEnglish from '@/assets/EMPAQUE INGLES.jpg';
import { SITE } from '@/consts';
import { resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const slides = [
	{ src: locale === 'en' ? bannerEnglish : banner, alt: t('hero.banner.alt') },
	{ src: locale === 'en' ? bannerPackEnglish : bannerPack, alt: t('hero.banner.pack.alt') },
] as const;
---

<section class="relative overflow-hidden bg-canvas pt-10 pb-16 sm:pt-14 lg:pt-16 lg:pb-20">
	<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-[38rem]">
			<p class="hero-reveal text-xs font-semibold tracking-[0.18em] text-primary uppercase sm:text-sm">
				{SITE.legalName}
			</p>

			<h1 class="mt-5 font-display text-[2.25rem] leading-[1.08] font-bold tracking-tight text-ink sm:text-4xl lg:text-[3.1rem]">
				<span class="hero-title-line block overflow-hidden"><span class="hero-title-inner block">{t('hero.title.a')}</span></span>
				<span class="hero-title-line block overflow-hidden"><span class="hero-title-inner block">{t('hero.title.b')}</span></span>
			</h1>

			<p class="hero-reveal mt-6 max-w-[46ch] text-base text-ink-muted sm:text-lg">
				{t('hero.subtitle')}
			</p>
		</div>

		<div class="hero-reveal mt-8 lg:mt-10">
			<div data-hero-carousel class="relative" tabindex="0" role="region" aria-roledescription="carousel">
				<div class="relative overflow-hidden rounded-2xl">
					<div data-carousel-track class="flex items-start transition-transform duration-500 ease-out motion-reduce:transition-none">
						{
							slides.map((slide, i) => (
								<div
									data-carousel-slide
									class="min-w-full"
									aria-hidden={i === 0 ? 'false' : 'true'}
								>
									<Image
										src={slide.src}
										alt={slide.alt}
										widths={[960, 1440, 1920, 2400]}
										sizes="(min-width: 1280px) 80rem, 100vw"
										loading={i === 0 ? 'eager' : 'lazy'}
										fetchpriority={i === 0 ? 'high' : 'low'}
										class="h-auto w-full"
									/>
								</div>
							))
						}
					</div>

					<button
						type="button"
						data-carousel-prev
						class="absolute top-1/2 left-3 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-surface text-ink shadow-sm hover:bg-canvas sm:left-4 sm:h-11 sm:w-11"
						aria-label={t('hero.carousel.prev')}
					>
						<svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
							<path d="M12 5 7 10l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<button
						type="button"
						data-carousel-next
						class="absolute top-1/2 right-3 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-surface text-ink shadow-sm hover:bg-canvas sm:right-4 sm:h-11 sm:w-11"
						aria-label={t('hero.carousel.next')}
					>
						<svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
							<path d="M8 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
				</div>

				<div class="mt-4 flex items-center justify-center gap-2" role="group" aria-label={t('hero.carousel.dots')}>
					{
						slides.map((slide, i) => (
							<button
								type="button"
								data-carousel-dot
								class="h-2 w-2 rounded-full bg-line-strong transition-[width,background-color] aria-[current=true]:w-6 aria-[current=true]:bg-primary"
								aria-label={slide.alt}
								aria-current={i === 0 ? 'true' : undefined}
							></button>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
		document.documentElement.dataset.heroAnim = 'on';
	}
</script>

<script>
	import '@/scripts/hero-animation';
	import '@/scripts/hero-carousel';
</script>

<style>
	:global(:root[data-hero-anim='on']) .hero-title-inner,
	:global(:root[data-hero-anim='on']) .hero-reveal {
		opacity: 0;
	}
</style>
