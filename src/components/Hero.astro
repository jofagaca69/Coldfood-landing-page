---
import { Image } from 'astro:assets';
import tostones from '@/assets/products/tostones-platano-verde.webp';
import maduros from '@/assets/products/platanos-maduros-enteros.webp';
import yuca from '@/assets/products/yuca-croqueta-prefrita.webp';
import { resolveLocale, useTranslations, getLocalizedPath } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const quotePath = getLocalizedPath('/contacto/', locale);
const catalogPath = getLocalizedPath('/productos/', locale);
---

<section class="relative overflow-hidden bg-canvas pt-10 pb-16 sm:pt-14 lg:min-h-[calc(100svh-7rem)] lg:pt-16 lg:pb-20">
	<div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.92fr)] lg:gap-8 lg:px-8">
		<!-- Columna izquierda: propuesta de valor -->
		<div class="max-w-[38rem]">
			<p
				class="hero-reveal inline-flex items-center gap-2 rounded-full bg-green-50 px-3 py-1.5 text-xs font-semibold tracking-wide text-green-800 uppercase ring-1 ring-green-200 sm:text-sm"
			>
				<svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5" />
					<path d="M6 10.5 8.7 13 14 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				{t('hero.badge')}
			</p>

			<h1 class="mt-5 font-display text-[2.25rem] leading-[1.08] font-normal tracking-tight text-ink sm:text-4xl lg:text-[3.1rem]">
				<span class="hero-title-line block overflow-hidden"><span class="hero-title-inner block">{t('hero.title.a')}</span></span>
				<span class="hero-title-line block overflow-hidden"
					><span class="hero-title-inner block text-brown-700">{t('hero.title.b')}</span></span
				>
			</h1>

			<p class="hero-reveal mt-6 max-w-[46ch] text-base text-ink-muted sm:text-lg">
				{t('hero.subtitle')}
			</p>

			<div class="hero-reveal mt-8 flex flex-wrap items-center gap-3">
				<a
					href={quotePath}
					class="inline-flex items-center gap-2 rounded-full bg-cta px-6 py-3 text-sm font-semibold whitespace-nowrap text-white hover:bg-cta-hover sm:text-base"
				>
					{t('hero.cta.primary')}
					<svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
				<a
					href={catalogPath}
					class="inline-flex items-center rounded-full border border-line-strong px-6 py-3 text-sm font-semibold whitespace-nowrap text-ink hover:bg-surface-muted sm:text-base"
				>
					{t('hero.cta.secondary')}
				</a>
			</div>
		</div>

		<!-- Columna derecha: composición de empaques -->
		<div class="relative mx-auto aspect-[6/7] w-full max-w-[26rem] lg:max-w-none">
			<!-- Disco cálido decorativo detrás de la pila de empaques: en % de esta
			     columna (no del <section> completo), así queda anclado a la pila en
			     cualquier ancho de pantalla en vez de derivar hacia el margen vacío
			     en monitores anchos. -->
			<div
				class="pointer-events-none absolute top-1/2 left-1/2 aspect-square w-[110%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-sand-100"
				aria-hidden="true"
			>
			</div>

			<div class="hero-pack absolute z-20" style="left: 0%; top: 12%; width: 46%;" data-fall-delay="1">
				<div class="hero-pack-float">
					<div class="hero-pack-card" style="--tilt: -6deg;">
						<Image
							src={tostones}
							alt={t('hero.pack.tostones.alt')}
							widths={[260, 520]}
							sizes="(min-width: 1024px) 260px, 45vw"
							loading="eager"
							class="h-full w-full object-cover"
						/>
					</div>
				</div>
			</div>

			<div class="hero-pack absolute z-10" style="left: 52%; top: 0%; width: 44%;" data-fall-delay="0">
				<div class="hero-pack-float">
					<div class="hero-pack-card" style="--tilt: 5deg;">
						<Image
							src={maduros}
							alt={t('hero.pack.maduros.alt')}
							widths={[260, 520]}
							sizes="(min-width: 1024px) 260px, 45vw"
							loading="eager"
							class="h-full w-full object-cover"
						/>
					</div>
				</div>
			</div>

			<div class="hero-pack absolute z-30" style="left: 34%; top: 38%; width: 48%;" data-fall-delay="2">
				<div class="hero-pack-float">
					<div class="hero-pack-card" style="--tilt: 2deg;">
						<Image
							src={yuca}
							alt={t('hero.pack.yuca.alt')}
							widths={[260, 520]}
							sizes="(min-width: 1024px) 260px, 45vw"
							loading="eager"
							fetchpriority="high"
							class="h-full w-full object-cover"
						/>
					</div>
				</div>
			</div>

			<p
				class="hero-reveal absolute bottom-[2%] left-0 z-40 inline-flex items-center gap-2 rounded-full bg-surface px-3 py-2 text-xs font-semibold text-ink shadow-[0_8px_24px_-8px_rgba(38,31,26,0.25)] sm:text-sm"
			>
				<svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path
						d="M10 2v16M10 2 6.5 5.5M10 2l3.5 3.5M10 18l-3.5-3.5M10 18l3.5-3.5M2 10h16M2 10l3.5-3.5M2 10l3.5 3.5M18 10l-3.5-3.5M18 10l-3.5 3.5"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
				{t('hero.coldChain')}
			</p>
		</div>
	</div>
</section>

<script is:inline>
	// Marca el documento antes de que se pinte nada, para que el CSS de abajo
	// pueda arrancar los elementos animados en opacity:0 sin parpadeo. Si el
	// usuario pidió menos movimiento, no se marca y todo se ve fijo desde ya.
	if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
		document.documentElement.dataset.heroAnim = 'on';
	}
</script>

<script>
	import '@/scripts/hero-animation';
</script>

<style>
	/* Estado inicial solo cuando el documento admite animación (ver script
	   is:inline arriba). Sin JS o con reduced motion, nunca se aplica y todo
	   se ve en su posición final desde el primer render. */
	:global(:root[data-hero-anim='on']) .hero-title-inner,
	:global(:root[data-hero-anim='on']) .hero-reveal,
	:global(:root[data-hero-anim='on']) .hero-pack {
		opacity: 0;
	}

	.hero-pack-card {
		aspect-ratio: 2 / 3;
		overflow: hidden;
		border-radius: 1rem;
		box-shadow: 0 24px 60px -16px color-mix(in oklch, var(--color-brown-950) 34%, transparent);
		outline: 1px solid color-mix(in oklch, var(--color-ink) 8%, transparent);
		outline-offset: -1px;
		rotate: var(--tilt, 0deg);
	}

	.hero-pack-float {
		will-change: transform;
	}
</style>
