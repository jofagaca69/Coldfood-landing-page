---
import { Image } from 'astro:assets';
import mainBanner from '@/assets/banner1.png';
import frozenBlackberryBanner from '@/assets/MORA CONGELADA BANNER.png';
import creolePotatoBanner from '@/assets/PAPA CRIOLLA BANNER.png';
import cassavaBanner from '@/assets/yuca.png';
import cassavaCroquetteBanner from '@/assets/YUCA CROQUETA.png';
import { getLocalizedPath, resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const slides = [mainBanner, creolePotatoBanner, cassavaBanner, cassavaCroquetteBanner, frozenBlackberryBanner] as const;

const features = [
	{ label: t('hero.feature.natural'), icon: 'M12 3c-1.5 3-6 4.5-6 9.5A6 6 0 0 0 12 18a6 6 0 0 0 6-5.5C18 7.5 13.5 6 12 3Z' },
	{ label: t('hero.feature.frozen'), icon: 'M10 2v16M10 2 6.5 5.5M10 2l3.5 3.5M10 18l-3.5-3.5M10 18l3.5-3.5M2 10h16M2 10l3.5-3.5M2 10l3.5 3.5M18 10l-3.5-3.5M18 10l-3.5 3.5' },
	{ label: t('hero.feature.flavor'), icon: 'M5 20c7-1.5 12-8 14-16-8 2.5-13.5 8-14 16Z M7 14c3-2 7-4.5 12-6' },
	{ label: t('hero.feature.markets'), icon: 'M10 2.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Zm0 0c1.8 1.9 2.8 4.4 2.8 7.5s-1 5.6-2.8 7.5m0-15c-1.8 1.9-2.8 4.4-2.8 7.5s1 5.6 2.8 7.5M2.8 10h14.4' },
] as const;
---

<section class="relative overflow-hidden bg-canvas">
	<div class="relative flex flex-col xl:block xl:aspect-[2048/768] xl:min-h-[30rem]">
				<div class="relative z-10 order-2 mx-auto w-full max-w-none px-4 pt-6 pb-8 sm:px-6 sm:py-8 xl:absolute xl:inset-0 xl:flex xl:items-center xl:px-8 xl:py-0 2xl:px-20">
					<div class="max-w-[38rem] rounded-2xl border border-line bg-surface p-5 shadow-xl sm:p-7 xl:max-w-[32rem] xl:p-5 2xl:max-w-[38rem] 2xl:p-8">
						<h1 class="hero-title font-display text-[2.1rem] leading-[1.1] font-bold tracking-tight sm:text-4xl xl:text-[1.625rem] 2xl:text-[3rem]">
							<span class="hero-title-line block overflow-hidden">
								<span class="hero-title-inner block text-ink">{t('hero.title.a')}</span>
							</span>
							<span class="hero-title-line block overflow-hidden">
								<span class="hero-title-inner block text-primary">{t('hero.title.b')}</span>
							</span>
						</h1>

						<p class="hero-reveal mt-4 inline-flex items-center gap-2 font-display text-lg font-semibold text-ink sm:text-xl xl:mt-3 xl:text-base 2xl:mt-4 2xl:text-xl">
							{t('hero.tagline')}
							<span class="h-1.5 w-10 rounded-full bg-accent" aria-hidden="true" />
						</p>

						<p class="hero-reveal mt-4 max-w-[46ch] text-base text-ink-muted sm:text-lg xl:mt-3 xl:text-sm xl:leading-relaxed 2xl:mt-4 2xl:text-lg">
							{t('hero.subtitle')}
						</p>

						<div class="hero-reveal mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center xl:mt-4 xl:gap-2 2xl:mt-7 2xl:gap-3">
							<a
								href={getLocalizedPath('/productos/', locale)}
								class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold whitespace-nowrap text-white hover:bg-primary-hover sm:text-base xl:px-5 xl:py-2.5 xl:text-sm 2xl:px-6 2xl:py-3 2xl:text-base"
							>
								{t('hero.cta.products')}
								<svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
									<path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
							<a
								href={getLocalizedPath('/contacto/', locale)}
								class="inline-flex items-center justify-center gap-2 rounded-full border border-line-strong bg-surface px-6 py-3 text-sm font-semibold whitespace-nowrap text-ink hover:bg-canvas sm:text-base xl:px-5 xl:py-2.5 xl:text-sm 2xl:px-6 2xl:py-3 2xl:text-base"
							>
								{t('hero.cta.primary')}
							</a>
						</div>

						<ul class="hero-reveal mt-6 grid grid-cols-2 gap-x-4 gap-y-3 xl:mt-4 xl:gap-y-2 2xl:mt-8 2xl:gap-y-3">
							{features.map((feature) => (
								<li class="flex items-center gap-2 text-xs font-semibold text-ink sm:text-sm xl:text-xs 2xl:text-sm">
									<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary xl:h-7 xl:w-7 2xl:h-8 2xl:w-8">
										<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
											<path d={feature.icon} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</span>
									{feature.label}
								</li>
							))}
						</ul>
					</div>
				</div>

				<div
					class="relative order-1 aspect-[8/3] w-full overflow-hidden bg-surface-muted xl:absolute xl:inset-0 xl:aspect-auto"
					data-hero-slideshow
				>
					{
						slides.map((slide, index) => (
							<Image
								src={slide}
								alt=""
								widths={[640, 960, 1440, 2048]}
								sizes="100vw"
								loading={index === 0 ? 'eager' : 'lazy'}
								fetchpriority={index === 0 ? 'high' : 'auto'}
								class:list={[
									'absolute inset-0 h-full w-full object-cover object-center transition-opacity duration-700',
									index === 0 ? 'opacity-100' : 'opacity-0',
								]}
								data-hero-slide
							/>
						))
					}
					<div
						class="absolute right-0 bottom-2 left-0 z-20 flex justify-center gap-2 xl:bottom-4"
						role="group"
						aria-label={locale === 'en' ? 'Choose banner image' : 'Elegir imagen del banner'}
					>
						{
							slides.map((_, index) => (
								<button
									type="button"
									class="h-2.5 w-2.5 rounded-full border border-primary bg-surface/80 shadow-sm transition-all hover:bg-surface"
									data-hero-indicator
									data-active={index === 0 ? 'true' : 'false'}
									aria-current={index === 0 ? 'true' : 'false'}
									aria-label={`${locale === 'en' ? 'Go to image' : 'Ir a la imagen'} ${index + 1}`}
								/>
							))
						}
					</div>
				</div>
			</div>
</section>

<script is:inline>
	if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
		document.documentElement.dataset.heroAnim = 'on';
	}
</script>

<script>
	import '@/scripts/hero-animation';

	document.querySelectorAll<HTMLElement>('[data-hero-slideshow]').forEach((slideshow) => {
		const slides = Array.from(slideshow.querySelectorAll<HTMLElement>('[data-hero-slide]'));
		const indicators = Array.from(slideshow.querySelectorAll<HTMLButtonElement>('[data-hero-indicator]'));
		if (slides.length < 2) return;

		let activeIndex = 0;
		const showSlide = (nextIndex: number) => {
			slides[activeIndex].classList.replace('opacity-100', 'opacity-0');
			indicators[activeIndex]?.setAttribute('data-active', 'false');
			indicators[activeIndex]?.setAttribute('aria-current', 'false');
			activeIndex = nextIndex;
			slides[activeIndex].classList.replace('opacity-0', 'opacity-100');
			indicators[activeIndex]?.setAttribute('data-active', 'true');
			indicators[activeIndex]?.setAttribute('aria-current', 'true');
		};

		indicators.forEach((indicator, index) => {
			indicator.addEventListener('click', () => showSlide(index));
		});

		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			window.setInterval(() => showSlide((activeIndex + 1) % slides.length), 4000);
		}
	});
</script>

<style>
	:global(:root[data-hero-anim='on']) .hero-title-inner,
	:global(:root[data-hero-anim='on']) .hero-reveal {
		opacity: 0;
	}

	[data-hero-indicator][data-active='true'] {
		width: 2rem;
		background-color: var(--color-primary);
	}
</style>
