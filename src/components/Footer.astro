---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';
import politicadeDatos from '@/assets/docs/Politicadedatos.pdf?url';
import { SITE } from '@/consts';
import { CONTACT, CONTACT_LINES, getWhatsAppUrl } from '@/data/contact';
import { resolveLocale, useTranslations, getLocalizedPath } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();

const homePath = getLocalizedPath('/', locale);
const aboutPath = getLocalizedPath('/conocenos/', locale);
const productsPath = getLocalizedPath('/productos/', locale);
const contactPath = getLocalizedPath('/contacto/', locale);
const pqrsdPath = getLocalizedPath('/pqrsd/', locale);

const companyLinks = [
	{ href: homePath, label: t('nav.home') },
	{ href: aboutPath, label: t('nav.about') },
	{ href: productsPath, label: t('nav.products') },
	{ href: contactPath, label: t('cta.contact') },
] as const;

// Coloca el href de cada enlace. Se abren en otra pestaña.
const generalLinks = [
	{ href: pqrsdPath, label: t('footer.general.pqrsd') },
	{ href: politicadeDatos, label: t('footer.general.privacy'), external: true },
	{ href: '', label: t('footer.general.claims') },
	{ href: '', label: t('footer.general.csr') },
	{ href: '', label: t('footer.general.ethics') },
	{ href: 'https://sedeelectronica.sic.gov.co', label: t('footer.general.sic'), external: true },
	{
		href: 'https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=44306',
		label: t('footer.general.consumer'),
		external: true,
	},
];

const socialIcons = {
	facebook: 'M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v7h3v-7h2.6L17 11h-3V9Z',
	instagram:
		'M8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5Zm8 1.8H8A3.2 3.2 0 0 0 4.8 8v8A3.2 3.2 0 0 0 8 19.2h8A3.2 3.2 0 0 0 19.2 16V8A3.2 3.2 0 0 0 16 4.8ZM12 8.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2Zm0 1.6A2.2 2.2 0 1 0 14.2 12 2.2 2.2 0 0 0 12 9.8Zm4.35-3.05a.95.95 0 1 1-.95.95.95.95 0 0 1 .95-.95Z',
	youtube:
		'M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 5 12 5 12 5s-6 0-7.7.3A2.7 2.7 0 0 0 2.4 7.2 28 28 0 0 0 2 12a28 28 0 0 0 .4 4.8 2.7 2.7 0 0 0 1.9 1.9C6 19 12 19 12 19s6 0 7.7-.3a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22 12a28 28 0 0 0-.4-4.8ZM10 15.2V8.8L15.5 12 10 15.2Z',
	tiktok: 'M14.2 3c.4 2.4 1.7 4 4.1 4.3v2.5a6.6 6.6 0 0 1-3.8-1.2v6.6a5.8 5.8 0 1 1-5.8-5.8c.3 0 .6 0 .9.1v2.7a3.1 3.1 0 1 0 2.2 3v-12h2.4Z',
	linkedin:
		'M6.5 9.5H3.7V20h2.8V9.5ZM5.1 4A1.6 1.6 0 1 0 5.1 7.2 1.6 1.6 0 0 0 5.1 4ZM20.3 20h-2.8v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V20H11V9.5h2.7v1.4h.1a3 3 0 0 1 2.7-1.5c2.8 0 3.8 1.9 3.8 4.3V20Z',
} as const;

const socials = [
	{ id: 'instagram', href: CONTACT.social.instagram, label: t('footer.social.instagram') },
	{ id: 'linkedin', href: CONTACT.social.linkedin, label: t('footer.social.linkedin') },
] as const;

const linkClass = 'text-sm text-ink hover:text-primary';
const iconClass = 'h-6 w-6 shrink-0';
---

<footer class="mt-auto border-t border-line bg-surface" aria-label={t('footer.landmark')}>
	<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-8">
		<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
			<a href={homePath} class="flex h-fit shrink-0 items-center">
				<Image src={logo} alt={SITE.name} class="h-16 w-auto lg:h-20" />
			</a>

			<nav aria-labelledby="footer-customer" class="min-w-0 shrink-0">
				<h2 id="footer-customer" class="text-sm font-semibold tracking-wide text-accent-ink uppercase">
					{t('footer.customer')}
				</h2>

				<ul class="mt-4 space-y-5">
					{
						CONTACT_LINES.map((line) => (
							<li>
								<p class="text-sm font-semibold text-ink">{t(line.labelKey)}</p>
								<a
									href={getWhatsAppUrl(t('whatsapp.message'), line.number)}
									target="_blank"
									rel="noopener noreferrer"
									class="mt-1 block text-sm text-ink-muted hover:text-primary"
								>
									{line.display}
								</a>
								<a
									href={`mailto:${line.email}`}
									class="mt-0.5 block text-sm whitespace-nowrap text-ink-muted hover:text-primary"
								>
									{line.email}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-labelledby="footer-general" class="min-w-0 max-w-64 shrink-0">
				<h2 id="footer-general" class="text-sm font-semibold tracking-wide text-accent-ink uppercase">
					{t('footer.general')}
				</h2>
				<ul class="mt-4 space-y-2.5">
					{
						generalLinks.map((item) => (
							<li>
								{item.href ? (
									<a
										href={item.href}
										class={linkClass}
										target={item.external ? '_blank' : undefined}
										rel={item.external ? 'noopener noreferrer' : undefined}
									>
										{item.label}
									</a>
								) : (
									<span class={linkClass}>{item.label}</span>
								)}
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-labelledby="footer-about" class="shrink-0">
				<h2 id="footer-about" class="text-sm font-semibold tracking-wide text-accent-ink uppercase">
					{t('footer.about')}
				</h2>
				<ul class="mt-4 space-y-2.5">
					{
						companyLinks.map((item) => (
							<li>
								<a href={item.href} class={linkClass}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-labelledby="footer-follow" class="shrink-0">
				<h2 id="footer-follow" class="text-sm font-semibold tracking-wide text-accent-ink uppercase">
					{t('footer.follow')}
				</h2>
				<ul class="mt-4 space-y-2.5">
					{
						socials.map((item) => (
							<li>
								<a
									href={item.href}
									target="_blank"
									rel="noopener noreferrer"
									class={`inline-flex items-center gap-2 ${linkClass}`}
								>
									<svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d={socialIcons[item.id]} />
									</svg>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>

	<div class="flex items-center justify-center bg-primary px-4 py-3 text-center text-xs font-medium text-white sm:text-sm">
		<span>
			© {year} {SITE.legalName}. {t('footer.copyright')}
		</span>
	</div>
</footer>

<style>
	@media (prefers-reduced-motion: no-preference) {
		footer a {
			transition: color 150ms ease;
		}
	}
</style>
