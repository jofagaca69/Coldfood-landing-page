---
import { Image } from 'astro:assets';
import { getProductsByCategory, type Product } from '@/data/products';
import { resolveLocale, useTranslations, getLocalizedPath } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const catalogPath = getLocalizedPath('/productos/', locale);

/** Un producto de cada línea principal (6 de 8 categorías: se omiten Costa Rica, muy cercana a frescos, y pulpas mix, muy cercana a pulpas). */
const FEATURED_CATEGORY_SLUGS = [
	'productos-frescos',
	'productos-pre-cocidos',
	'frutas-congeladas',
	'productos-pre-fritos',
	'pulpas-de-frutas',
	'masas-listas',
] as const;

const featured = FEATURED_CATEGORY_SLUGS.map((slug) => getProductsByCategory(slug)[0]).filter(
	(product): product is Product => product !== undefined,
);
---

<section class="border-t border-line bg-canvas py-10 sm:py-20 lg:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-wrap items-end justify-between gap-3 sm:gap-4">
			<div>
				<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase sm:text-sm">
					{t('home.featured.kicker')}
				</p>
				<h2 class="mt-2 font-display text-2xl leading-[1.12] font-normal text-ink sm:mt-3 sm:text-3xl lg:text-4xl">
					{t('home.featured.title')}
				</h2>
			</div>
			<a href={catalogPath} class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
				{t('home.featured.cta')}
				<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</div>

		<ul class="mt-6 grid grid-cols-2 gap-3 sm:mt-10 sm:gap-6 lg:grid-cols-3 xl:grid-cols-6">
			{
				featured.map((product) => {
					const copy = product[locale];
					const href = getLocalizedPath(`/productos/${product.slug}/`, locale);
					const [main] = product.gallery;
					const presentation = product.variants[0]?.[locale].presentation;

					return (
						<li>
							<a
								href={href}
								class="group flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface transition hover:-translate-y-0.5 hover:shadow-[0_20px_45px_-24px_rgba(38,31,26,0.35)] sm:rounded-2xl"
							>
								<div class="aspect-square overflow-hidden bg-surface-muted p-2 sm:p-4">
									{main ? (
										<Image
											src={main.src[locale]}
											alt={main.alt[locale]}
											widths={[220, 360]}
											sizes="(min-width: 1280px) 12rem, (min-width: 640px) 30vw, 45vw"
											class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]"
										/>
									) : null}
								</div>
								<div class="flex items-start justify-between gap-1.5 px-2.5 py-2 sm:gap-2 sm:px-4 sm:py-3">
									<div class="min-w-0">
										<h3 class="text-xs font-semibold text-ink sm:text-sm">{copy.name}</h3>
										{presentation && <p class="mt-0.5 text-[11px] text-ink-muted sm:text-xs">{presentation}</p>}
									</div>
									<span class="mt-0.5 hidden h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary sm:flex">
										<svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
											<path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</span>
								</div>
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
