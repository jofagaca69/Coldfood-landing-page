---
import { Image } from 'astro:assets';
import plantImage from '@/assets/siembra.jpg';
import mapImage from '@/assets/mapa.jpg';
import { resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const pillars = [
	{
		index: '01',
		title: t('home.about.more.practice.title'),
		body: t('home.about.more.practice.body'),
		icon: 'M12 7v5l3 2M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z',
	},
	{
		index: '02',
		title: t('home.about.more.fresh.title'),
		body: t('home.about.more.fresh.body'),
		icon: 'M12 3v3M12 18v3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M3 12h3M18 12h3M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1M9.5 9.5 12 12l2.5 2.5M14.5 9.5 12 12l-2.5 2.5',
	},
	{
		index: '03',
		title: t('home.about.more.flavor.title'),
		body: t('home.about.more.flavor.body'),
		icon: 'M5 20c7-1.5 12-8 14-16-8 2.5-13.5 8-14 16Z M7 14c3-2 7-4.5 12-6',
	},
] as const;
---

<section class="border-t border-line bg-canvas py-16 sm:py-20 lg:py-24">
	<div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
		<div class="mx-auto w-full max-w-md overflow-hidden rounded-2xl lg:mx-0 lg:max-w-lg">
			<Image
				src={plantImage}
				alt={t('home.about.imageAlt')}
				widths={[640, 960, 1280]}
				sizes="(min-width: 1024px) 32rem, (min-width: 448px) 28rem, 100vw"
				class="aspect-[16/10] h-full w-full object-cover object-[center_18%]"
			/>
		</div>

		<div>
			<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase sm:text-sm">{t('home.about.kicker')}</p>
			<h2 class="mt-3 max-w-[22ch] font-display text-3xl leading-[1.12] font-normal text-ink sm:text-4xl">
				{t('home.about.title')}
			</h2>
			<p class="mt-5 max-w-[54ch] text-base leading-relaxed text-ink-muted sm:text-lg">{t('home.about.body')}</p>
			<p class="mt-4 max-w-[54ch] text-base leading-relaxed text-ink-muted sm:text-lg">{t('home.about.body2')}</p>
		</div>
	</div>
</section>

<section class="border-t border-line bg-surface py-16 sm:py-20 lg:py-24">
	<div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
		<div>
			<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase sm:text-sm">{t('home.markets.kicker')}</p>
			<h2 class="mt-3 max-w-[22ch] font-display text-3xl leading-[1.12] font-normal text-ink sm:text-4xl">
				{t('home.markets.title')}
			</h2>
			<p class="mt-5 max-w-[54ch] text-base leading-relaxed text-ink-muted sm:text-lg">{t('home.markets.body')}</p>
		</div>
		<div>
			<Image
				src={mapImage}
				alt={t('home.markets.imageAlt')}
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 1024px) 36rem, 100vw"
				class="h-auto w-full"
			/>
		</div>
	</div>
</section>

<section class="border-t border-line bg-canvas py-16 sm:py-20 lg:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase sm:text-sm">
				{t('home.about.more.kicker')}
			</p>
			<h2 class="mt-2 font-display text-2xl leading-[1.12] font-normal text-ink sm:mt-3 sm:text-3xl lg:text-4xl">
				{t('home.about.more.title')}
			</h2>
		</div>

		<ol class="mt-6 grid gap-3 sm:mt-12 sm:grid-cols-3 sm:gap-5">
			{
				pillars.map((item) => (
					<li class="flex items-start gap-3 rounded-xl border border-line bg-surface p-4 sm:flex-col sm:rounded-2xl sm:p-8">
						<div class="flex shrink-0 items-center sm:w-full sm:justify-between">
							<span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary sm:h-14 sm:w-14 sm:rounded-2xl">
								<svg class="h-5 w-5 sm:h-7 sm:w-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d={item.icon}
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</span>
							<span class="hidden font-display text-4xl leading-none text-primary/20 sm:inline" aria-hidden="true">
								{item.index}
							</span>
						</div>
						<div class="min-w-0">
							<h3 class="font-display text-lg font-normal text-ink sm:mt-8 sm:text-2xl">{item.title}</h3>
							<p class="mt-1 text-sm leading-relaxed text-ink-muted sm:mt-3 sm:text-base">{item.body}</p>
							<span class="mt-3 hidden h-1 w-12 rounded-full bg-accent sm:mt-8 sm:block" aria-hidden="true" />
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
