---
import { Image } from 'astro:assets';
import collectorImage from '@/assets/recolector.png';
import { getLocalizedPath, resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const stats = [
	{ label: t('home.about.stat.years'), icon: 'M4 3.5h12v13H4zM4 7h12M7 3.5V2M13 3.5V2' },
	{ label: t('home.about.stat.origin'), icon: 'M10 3v3M10 3 7.5 5.5M10 3l2.5 2.5M4 12c0-4 2.5-6 6-6s6 2 6 6-2.5 6-6 6-6-2-6-6Z' },
	{ label: t('home.about.stat.quality'), icon: 'M10 2.8v2M10 15.2v2M2.8 10h2M15.2 10h2M5 5l1.4 1.4M13.6 13.6 15 15M15 5l-1.4 1.4M6.4 13.6 5 15M10 6a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z' },
	{ label: t('home.about.stat.markets'), icon: 'M2.5 13.5h11v-6h-7l-2 2.5H2.5zM13.5 13.5h4l2-3.5h-6zM6 15.2a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2ZM16 15.2a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Z' },
] as const;
---

<section class="border-t border-line bg-canvas py-10 sm:py-12 lg:py-14">
	<div class="mx-auto grid max-w-6xl items-center gap-8 px-4 sm:px-6 lg:grid-cols-[1.4fr_1fr_0.72fr] lg:gap-8 lg:px-8 xl:gap-10">
		<div class="mx-auto w-full max-w-md overflow-hidden rounded-2xl lg:mx-0 lg:max-w-none">
			<Image
				src={collectorImage}
				alt={t('home.about.imageAlt')}
				widths={[640, 960, 1280]}
				sizes="(min-width: 1024px) 32rem, (min-width: 448px) 28rem, 100vw"
				class="aspect-[16/10] h-full w-full object-cover object-[center_18%]"
			/>
		</div>

		<div>
			<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase sm:text-sm">{t('home.about.kicker')}</p>
			<h2 class="mt-2 max-w-[22ch] font-display text-2xl leading-[1.12] font-semibold text-ink sm:text-3xl">
				{t('home.about.title')}
			</h2>
			<p class="mt-4 max-w-[54ch] text-sm leading-relaxed text-ink-muted sm:text-base">
				{t('home.about.body')} {t('home.about.body2')}
			</p>

			<a
				href={getLocalizedPath('/conocenos/', locale)}
				class="mt-5 inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-2.5 text-sm font-semibold text-ink hover:bg-surface-muted"
			>
				{t('home.about.cta')}
				<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</div>

		<ul class="grid gap-5 border-t border-line pt-8 sm:grid-cols-2 lg:grid-cols-1 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
			{
				stats.map((stat) => (
					<li class="flex items-center gap-3">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
							<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
								<path d={stat.icon} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
						<span class="text-sm font-medium text-ink">{stat.label}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
