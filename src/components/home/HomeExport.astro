---
import { Image } from 'astro:assets';
import exportImage from '@/assets/inicio2.png';
import { getLocalizedPath, resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="relative overflow-hidden border-t border-line bg-surface py-16 sm:py-20 lg:py-24">
	<Image
		src={exportImage}
		alt={t('home.export.imageAlt')}
		widths={[640, 960, 1280, 1600, 2048]}
		sizes="100vw"
		quality={100}
		class="absolute inset-0 h-full w-full object-cover object-[60%_40%] sm:object-[center_40%]"
	/>

	<div class="relative w-full px-4 sm:px-6 lg:px-20 xl:px-24">
		<div class="max-w-xl">
			<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase sm:text-sm">{t('home.export.kicker')}</p>
			<h2 class="mt-3 max-w-[22ch] font-display text-3xl leading-[1.12] font-semibold text-ink sm:text-4xl">
				{t('home.export.title')}
			</h2>
			<p class="mt-5 max-w-[54ch] text-base leading-relaxed text-ink-muted sm:text-lg">{t('home.export.body')}</p>

			<a
				href={getLocalizedPath('/conocenos/', locale)}
				class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold whitespace-nowrap text-white hover:bg-primary-hover"
			>
				{t('home.export.cta')}
				<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</div>
	</div>
</section>
