---
import { Image } from 'astro:assets';
import exportImage from '@/assets/inicio2.png';
import { resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="relative overflow-hidden border-t border-line bg-canvas pb-10 sm:bg-surface sm:py-20 lg:py-24">
	<Image
		src={exportImage}
		alt={t('home.export.imageAlt')}
		widths={[640, 960, 1280, 1600, 2048]}
		sizes="100vw"
		quality={100}
		class="relative h-56 w-full object-cover object-[62%_center] sm:absolute sm:inset-0 sm:h-full sm:object-[center_40%]"
	/>

	<div class="relative -mt-5 w-full px-4 sm:mt-0 sm:px-6 lg:px-20 xl:px-24">
		<div class="max-w-xl rounded-2xl border border-line bg-surface p-5 shadow-sm sm:rounded-none sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none">
			<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase sm:text-sm">{t('home.export.kicker')}</p>
			<h2 class="mt-3 max-w-[22ch] font-display text-3xl leading-[1.12] font-semibold text-ink sm:text-4xl">
				{t('home.export.title')}
			</h2>
			<p class="mt-5 max-w-[54ch] text-base leading-relaxed text-ink-muted sm:text-lg">{t('home.export.body')}</p>
		</div>
	</div>
</section>
