---
import { resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const steps = [
	{ label: t('home.process.step1'), icon: 'M10 17c3-1 5.5-3.5 6-8-3.5 1-6 3-6 8Zm0 0c-3-1-5.5-3.5-6-8 3.5 1 6 3 6 8Z' },
	{ label: t('home.process.step2'), icon: 'M10 2.5 16.5 6.25v7.5L10 17.5l-6.5-3.75v-7.5L10 2.5ZM10 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z' },
	{ label: t('home.process.step3'), icon: 'M3 6.5 10 3l7 3.5-7 3.5-7-3.5Zm0 0v7l7 3.5m0-10.5v10.5m7-10.5v7l-7 3.5' },
	{ label: t('home.process.step4'), icon: 'M10 2v16M10 2 6.5 5.5M10 2l3.5 3.5M10 18l-3.5-3.5M10 18l3.5-3.5M2 10h16M2 10l3.5-3.5M2 10l3.5 3.5M18 10l-3.5-3.5M18 10l-3.5 3.5' },
	{ label: t('home.process.step5'), icon: 'M3 8.5 10 3l7 5.5V17H3V8.5Zm4 8.5v-6h6v6' },
	{ label: t('home.process.step6'), icon: 'M2 5.5h10v8H2v-8ZM12 8h3.5l2.5 3v2.5h-6V8ZM5 16a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM15.5 16a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z' },
] as const;
---

<section class="border-t border-line bg-surface-muted py-14 sm:py-16 lg:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:flex lg:items-center lg:gap-16 lg:px-8">
		<div class="max-w-md">
			<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase sm:text-sm">{t('home.process.kicker')}</p>
			<h2 class="mt-2 font-display text-2xl leading-[1.15] font-semibold text-ink sm:mt-3 sm:text-3xl">
				{t('home.process.title')}
			</h2>
			<p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">{t('home.process.body')}</p>
		</div>

		<ol class="mt-8 grid grid-cols-3 gap-x-4 gap-y-6 sm:grid-cols-6 lg:mt-0 lg:flex-1 lg:grid-cols-none lg:flex lg:items-start">
			{
				steps.map((step, i) => (
					<>
						<li class="flex flex-col items-center text-center">
							<span class="flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary">
								<svg class="h-7 w-7" viewBox="0 0 20 20" fill="none" aria-hidden="true">
									<path d={step.icon} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
							<span class="mt-2 max-w-[7rem] text-xs font-semibold text-ink sm:text-sm">{step.label}</span>
						</li>
						{i < steps.length - 1 && (
							<li aria-hidden="true" class="hidden shrink-0 self-start pt-7 text-line-strong lg:flex">
								<svg class="h-4 w-8" viewBox="0 0 32 16" fill="none">
									<path d="M2 8h26M22 3l6 5-6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</li>
						)}
					</>
				))
			}
		</ol>
	</div>
</section>
