---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';
import { SITE } from '@/consts';
import { CATEGORIES } from '@/data/categories';
import { resolveLocale, useTranslations, getLocalizedPath, getPathWithoutLocale } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const otherLocale = SITE.locales.find((l) => l !== locale)!;

const basePath = getPathWithoutLocale(Astro.url.pathname, locale);
const otherLocalePath = getLocalizedPath(basePath, otherLocale);

const homePath = getLocalizedPath('/', locale);
const aboutPath = getLocalizedPath('/conocenos/', locale);
const productsPath = getLocalizedPath('/productos/', locale);
const contactPath = getLocalizedPath('/contacto/', locale);

const localeLabel: Record<string, string> = { es: 'ES', en: 'EN' };
---

<header class="sticky top-0 z-50 border-b border-line bg-surface">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
		<a href={homePath} class="flex shrink-0 items-center gap-2">
			<Image src={logo} alt="Coldfood" class="h-12 w-auto" />
		</a>

		<!-- Navegación de escritorio -->
		<nav aria-label={t('nav.main')} class="hidden items-center gap-6 lg:flex">
			<a href={homePath} class="text-sm font-medium text-ink hover:text-primary">{t('nav.home')}</a>
			<a href={aboutPath} class="text-sm font-medium text-ink hover:text-primary">{t('nav.about')}</a>

			<details data-menu class="group relative">
				<summary class="flex cursor-pointer list-none items-center gap-1 text-sm font-medium text-ink hover:text-primary">
					{t('nav.categories')}
					<svg
						class="h-3.5 w-3.5 transition-transform group-open:rotate-180"
						viewBox="0 0 20 20"
						fill="none"
						aria-hidden="true"
					>
						<path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>
				<ul class="absolute left-0 top-full mt-2 w-64 rounded-lg border border-line bg-surface py-2 shadow-lg">
					{
						CATEGORIES.map((cat) => (
							<li>
								<a
									href={`${productsPath}#${cat.slug}`}
									class="block px-4 py-2 text-sm text-ink hover:bg-surface-muted hover:text-primary"
								>
									{cat[locale]}
								</a>
							</li>
						))
					}
				</ul>
			</details>

			<a href={productsPath} class="text-sm font-medium text-ink hover:text-primary">{t('nav.products')}</a>
			<a href={contactPath} class="text-sm font-medium text-ink hover:text-primary">{t('cta.contact')}</a>
		</nav>

		<div class="flex items-center gap-3">
			<!-- Selector de idioma (escritorio) -->
			<div class="hidden items-center gap-1 text-sm font-medium lg:flex" aria-label={t('nav.language')}>
				<a
					href={locale === 'es' ? Astro.url.pathname + Astro.url.search : otherLocalePath}
					hreflang="es"
					aria-current={locale === 'es' ? 'true' : undefined}
					class={locale === 'es' ? 'text-primary' : 'text-ink-subtle hover:text-primary'}
				>
					{localeLabel.es}
				</a>
				<span class="text-line-strong" aria-hidden="true">/</span>
				<a
					href={locale === 'en' ? Astro.url.pathname + Astro.url.search : otherLocalePath}
					hreflang="en"
					aria-current={locale === 'en' ? 'true' : undefined}
					class={locale === 'en' ? 'text-primary' : 'text-ink-subtle hover:text-primary'}
				>
					{localeLabel.en}
				</a>
			</div>

			<!-- Menú móvil -->
			<details data-menu class="group relative lg:hidden">
				<summary
					class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-ink hover:bg-surface-muted"
					aria-label={t('nav.menuOpen')}
				>
					<svg class="h-6 w-6 group-open:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
					</svg>
					<svg class="hidden h-6 w-6 group-open:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
					</svg>
				</summary>

				<div class="absolute right-0 top-full mt-2 w-72 rounded-lg border border-line bg-surface py-2 shadow-lg">
					<nav aria-label={t('nav.main')} class="flex flex-col">
						<a href={homePath} class="px-4 py-2.5 text-sm font-medium text-ink hover:bg-surface-muted hover:text-primary">
							{t('nav.home')}
						</a>
						<a href={aboutPath} class="px-4 py-2.5 text-sm font-medium text-ink hover:bg-surface-muted hover:text-primary">
							{t('nav.about')}
						</a>

						<details data-menu class="group/cat">
							<summary class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 text-sm font-medium text-ink hover:bg-surface-muted hover:text-primary">
								{t('nav.categories')}
								<svg
									class="h-3.5 w-3.5 transition-transform group-open/cat:rotate-180"
									viewBox="0 0 20 20"
									fill="none"
									aria-hidden="true"
								>
									<path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</summary>
							<ul class="bg-surface-muted/60 py-1">
								{
									CATEGORIES.map((cat) => (
										<li>
											<a
												href={`${productsPath}#${cat.slug}`}
												class="block px-6 py-2 text-sm text-ink-muted hover:text-primary"
											>
												{cat[locale]}
											</a>
										</li>
									))
								}
							</ul>
						</details>

						<a href={productsPath} class="px-4 py-2.5 text-sm font-medium text-ink hover:bg-surface-muted hover:text-primary">
							{t('nav.products')}
						</a>
						<a href={contactPath} class="px-4 py-2.5 text-sm font-medium text-ink hover:bg-surface-muted hover:text-primary">
							{t('cta.contact')}
						</a>

						<div class="mt-1 flex items-center gap-1 border-t border-line px-4 pt-2.5 text-sm font-medium" aria-label={t('nav.language')}>
							<a
								href={locale === 'es' ? Astro.url.pathname + Astro.url.search : otherLocalePath}
								hreflang="es"
								aria-current={locale === 'es' ? 'true' : undefined}
								class={locale === 'es' ? 'text-primary' : 'text-ink-subtle hover:text-primary'}
							>
								{localeLabel.es}
							</a>
							<span class="text-line-strong" aria-hidden="true">/</span>
							<a
								href={locale === 'en' ? Astro.url.pathname + Astro.url.search : otherLocalePath}
								hreflang="en"
								aria-current={locale === 'en' ? 'true' : undefined}
								class={locale === 'en' ? 'text-primary' : 'text-ink-subtle hover:text-primary'}
							>
								{localeLabel.en}
							</a>
						</div>
					</nav>
				</div>
			</details>
		</div>
	</div>
</header>

<script>
	// Mejora progresiva: el desplegable de categorías y el menú móvil son
	// <details> nativos y funcionan sin JS. Esto solo los cierra al hacer
	// click afuera o al presionar Escape.
	document.addEventListener('click', (event) => {
		document.querySelectorAll('details[data-menu][open]').forEach((el) => {
			if (!el.contains(event.target as Node)) el.removeAttribute('open');
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		document.querySelectorAll('details[data-menu][open]').forEach((el) => el.removeAttribute('open'));
	});
</script>

<style>
	summary {
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
</style>
