---
import Layout from '@/layouts/Layout.astro';
import FormNotice from '@/components/FormNotice.astro';
import politicadeDatos from '@/assets/docs/Politicadedatos.pdf?url';
import { resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';

const requestTypes = [
	{ value: 'peticion', label: t('pqrsd.form.type.peticion'), desc: t('pqrsd.explain.peticion') },
	{ value: 'queja', label: t('pqrsd.form.type.queja'), desc: t('pqrsd.explain.queja') },
	{ value: 'reclamo', label: t('pqrsd.form.type.reclamo'), desc: t('pqrsd.explain.reclamo') },
	{ value: 'sugerencia', label: t('pqrsd.form.type.sugerencia'), desc: t('pqrsd.explain.sugerencia') },
	{ value: 'denuncia', label: t('pqrsd.form.type.denuncia'), desc: t('pqrsd.explain.denuncia') },
] as const;

const inputClass =
	'w-full rounded-lg border border-white/25 bg-white/10 px-4 py-3 text-white placeholder:text-white/55 transition hover:border-white/45 focus-visible:outline-white';
const selectClass = `${inputClass} bg-surface text-ink`;
---

<Layout title={t('pqrsd.seoTitle')} description={t('pqrsd.seoDescription')}>
	<main>
		<section class="mx-auto max-w-6xl px-4 pt-12 pb-6 sm:px-6 sm:pt-16 lg:px-8">
			<h1 class="max-w-2xl font-display text-4xl leading-[1.08] font-bold text-ink sm:text-5xl">
				{t('pqrsd.title')}
			</h1>
			<p class="mt-4 max-w-[58ch] text-base text-ink-muted sm:text-lg">
				{t('pqrsd.subtitle')}
			</p>
		</section>

		<section class="bg-canvas">
			<div class="mx-auto grid max-w-6xl gap-10 px-4 pt-2 pb-14 sm:px-6 lg:grid-cols-2 lg:items-start lg:gap-14 lg:px-8 lg:pt-4 lg:pb-20">
				<div class="rounded-2xl bg-primary p-6 text-white shadow-sm sm:p-8">
					<p class="text-sm font-medium text-white/75">{t('pqrsd.form.kicker')}</p>
					<h2 class="mt-1 text-3xl font-bold tracking-tight">{t('pqrsd.form.title')}</h2>

					<form
						id="pqrsd-form"
						class="mt-8 grid gap-4"
						action="https://api.web3forms.com/submit"
						method="POST"
						data-web3forms
						data-sending={t('form.sending')}
						data-error={t('form.error')}
						data-configuration-error={t('form.configurationError')}
					>
						<input type="hidden" name="access_key" value={web3FormsAccessKey} />
						<input type="hidden" name="subject" value={t('pqrsd.form.mailSubject')} />
						<input type="hidden" name="from_name" value="Coldfood · Formulario PQRSD" />
						<input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

						<label class="block">
							<span class="mb-1.5 block text-sm font-medium">{t('pqrsd.form.type')}</span>
							<select name="type" required class={selectClass}>
								<option value="" disabled selected class="bg-surface text-ink">{t('pqrsd.form.typePlaceholder')}</option>
								{requestTypes.map((item) => <option value={item.label} class="bg-surface text-ink">{item.label}</option>)}
							</select>
						</label>

						<label class="block">
							<span class="mb-1.5 block text-sm font-medium">{t('pqrsd.form.name')}</span>
							<input
								type="text"
								name="name"
								autocomplete="name"
								required
								placeholder={t('pqrsd.form.namePlaceholder')}
								class={inputClass}
							/>
						</label>

						<div class="grid gap-4 sm:grid-cols-2">
							<label class="block">
								<span class="mb-1.5 block text-sm font-medium">{t('pqrsd.form.email')}</span>
								<input
									type="email"
									name="email"
									autocomplete="email"
									required
									placeholder={t('pqrsd.form.emailPlaceholder')}
									class={inputClass}
								/>
							</label>

							<label class="block">
								<span class="mb-1.5 block text-sm font-medium">{t('pqrsd.form.phone')}</span>
								<input
									type="tel"
									name="phone"
									autocomplete="tel"
									required
									placeholder={t('pqrsd.form.phonePlaceholder')}
									class={inputClass}
								/>
							</label>
						</div>

						<label class="block">
							<span class="mb-1.5 block text-sm font-medium">{t('pqrsd.form.city')}</span>
							<input
								type="text"
								name="city"
								autocomplete="address-level2"
								required
								placeholder={t('pqrsd.form.cityPlaceholder')}
								class={inputClass}
							/>
						</label>

						<label class="block">
							<span class="mb-1.5 block text-sm font-medium">{t('pqrsd.form.subject')}</span>
							<input
								type="text"
								name="request_subject"
								required
								placeholder={t('pqrsd.form.subjectPlaceholder')}
								class={inputClass}
							/>
						</label>

						<label class="block">
							<span class="mb-1.5 block text-sm font-medium">{t('pqrsd.form.message')}</span>
							<textarea
								name="message"
								rows="5"
								required
								placeholder={t('pqrsd.form.messagePlaceholder')}
								class:list={[inputClass, 'resize-y']}
							></textarea>
						</label>

						<label class="mt-1 flex items-start gap-3 text-sm leading-snug text-white/90">
							<input
								type="checkbox"
								name="privacy"
								required
								class="mt-0.5 h-4 w-4 shrink-0 rounded border-white/45 bg-white/10 accent-white"
							/>
							<span>
								{t('contact.form.privacyPrefix')}
								<a
									href={politicadeDatos}
									data-privacy-link
									target="_blank"
									rel="noopener noreferrer"
									class="underline underline-offset-2 hover:text-white"
								>
									{t('contact.form.privacyLink')}
								</a>
								{t('contact.form.privacySuffix')}
							</span>
						</label>

						<button
							type="submit"
							class="mt-2 inline-flex w-full items-center justify-center rounded-full bg-surface px-6 py-3 text-sm font-semibold text-primary transition hover:bg-canvas disabled:cursor-wait disabled:opacity-65"
						>
							{t('pqrsd.form.submit')}
						</button>
						<p data-form-status hidden role="alert" class="text-center text-sm font-medium text-white"></p>
					</form>
				</div>

				<div>
					<h2 class="text-lg font-semibold text-ink">{t('pqrsd.explain.title')}</h2>
					<ul class="mt-6 space-y-5">
						{
							requestTypes.map((item) => (
								<li>
									<p class="text-sm font-semibold text-primary">{item.label}</p>
									<p class="mt-1 text-sm leading-relaxed text-ink-muted">{item.desc}</p>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>
	</main>
	<FormNotice />
</Layout>

<script>
	import '@/scripts/web3forms';
</script>
