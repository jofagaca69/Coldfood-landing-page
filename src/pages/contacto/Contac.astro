---
import Layout from '@/layouts/Layout.astro';
import { CONTACT } from '@/consts';
import { resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const whatsappHref = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(t('contact.whatsapp.prefill'))}`;
const pqrsHref = `mailto:${CONTACT.pqrsEmail}?subject=${encodeURIComponent(t('contact.form.pqrsSubject'))}`;
const emailHref = `mailto:${CONTACT.email}`;

const channels = [
	{
		id: 'whatsapp',
		href: whatsappHref,
		external: true,
		title: t('contact.whatsapp.title'),
		desc: t('contact.whatsapp.desc'),
		cta: t('contact.whatsapp.cta'),
		meta: CONTACT.whatsappDisplay,
		iconClass: 'bg-primary text-white',
		icon: 'whatsapp',
	},
	{
		id: 'pqrs',
		href: pqrsHref,
		external: false,
		title: t('contact.pqrs.title'),
		desc: t('contact.pqrs.desc'),
		cta: t('contact.pqrs.cta'),
		meta: CONTACT.pqrsEmail,
		iconClass: 'bg-accent text-ink',
		icon: 'pqrs',
	},
	{
		id: 'email',
		href: emailHref,
		external: false,
		title: t('contact.email.title'),
		desc: t('contact.email.desc'),
		cta: t('contact.email.cta'),
		meta: CONTACT.email,
		iconClass: 'bg-cta text-white',
		icon: 'email',
	},
] as const;
---

<Layout title={t('contact.seoTitle')} description={t('contact.seoDescription')}>
	<main class="relative overflow-hidden">
		<div
			class="pointer-events-none absolute inset-x-0 top-0 h-80 bg-linear-to-b from-primary/8 to-transparent"
			aria-hidden="true"
		></div>

		<div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
			<header class="mx-auto max-w-2xl text-center">
				<p class="text-sm font-semibold tracking-[0.2em] text-accent-ink uppercase">{t('contact.eyebrow')}</p>
				<h1 class="mt-3 text-3xl font-bold tracking-tight text-primary sm:text-5xl">{t('contact.title')}</h1>
				<p class="mt-4 text-base text-ink-muted sm:text-lg">{t('contact.subtitle')}</p>
			</header>

			<section class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label={t('contact.title')}>
				{
					channels.map((channel) => (
						<a
							href={channel.href}
							target={channel.external ? '_blank' : undefined}
							rel={channel.external ? 'noopener noreferrer' : undefined}
							class="group flex flex-col rounded-2xl border border-line bg-surface p-5 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-primary/35 hover:shadow-md"
						>
							<div class:list={['flex h-12 w-12 items-center justify-center rounded-xl', channel.iconClass]}>
								{channel.icon === 'whatsapp' && (
									<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
									</svg>
								)}
								{channel.icon === 'pqrs' && (
									<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path
											d="M7 3.75h7.5L19.25 8.5V20.25a.75.75 0 0 1-.75.75H7a.75.75 0 0 1-.75-.75V4.5A.75.75 0 0 1 7 3.75Z"
											stroke="currentColor"
											stroke-width="1.75"
										/>
										<path d="M14.25 3.75V8.5h5" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
										<path
											d="M9 12.25h6M9 15.75h4"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
										/>
									</svg>
								)}
								{channel.icon === 'email' && (
									<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<rect
											x="3.75"
											y="5.75"
											width="16.5"
											height="12.5"
											rx="1.75"
											stroke="currentColor"
											stroke-width="1.75"
										/>
										<path
											d="m4.5 7.5 7.5 5.25L19.5 7.5"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								)}
							</div>

							<h2 class="mt-4 text-lg font-semibold text-ink">{channel.title}</h2>
							<p class="mt-1 flex-1 text-sm text-ink-muted">{channel.desc}</p>
							<p class="mt-3 truncate text-sm font-medium text-ink">{channel.meta}</p>
							<span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-link">
								{channel.cta}
								<svg
									class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
									viewBox="0 0 20 20"
									fill="none"
									aria-hidden="true"
								>
									<path
										d="M4 10h12M12 6l4 4-4 4"
										stroke="currentColor"
										stroke-width="1.75"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</span>
						</a>
					))
				}
			</section>

			<section class="mt-10 rounded-2xl border border-line bg-surface p-6 shadow-sm sm:p-8 lg:p-10">
				<div class="max-w-2xl">
					<h2 class="text-2xl font-semibold text-ink">{t('contact.form.title')}</h2>
					<p class="mt-2 text-ink-muted">{t('contact.form.subtitle')}</p>
				</div>

				<form
					id="contact-form"
					class="mt-8 grid gap-5 sm:grid-cols-2"
					data-email={CONTACT.email}
					data-subject={t('contact.form.subject')}
					data-label-name={t('contact.form.bodyName')}
					data-label-email={t('contact.form.bodyEmail')}
					data-label-phone={t('contact.form.bodyPhone')}
				>
					<label class="block">
						<span class="mb-1.5 block text-sm font-medium text-ink">{t('contact.form.name')}</span>
						<input
							type="text"
							name="name"
							autocomplete="name"
							required
							placeholder={t('contact.form.namePlaceholder')}
							class="w-full rounded-xl border border-line bg-canvas px-4 py-3 text-ink placeholder:text-ink-subtle transition hover:border-line-strong"
						/>
					</label>

					<label class="block">
						<span class="mb-1.5 block text-sm font-medium text-ink">{t('contact.form.email')}</span>
						<input
							type="email"
							name="email"
							autocomplete="email"
							required
							placeholder={t('contact.form.emailPlaceholder')}
							class="w-full rounded-xl border border-line bg-canvas px-4 py-3 text-ink placeholder:text-ink-subtle transition hover:border-line-strong"
						/>
					</label>

					<label class="block sm:col-span-2 lg:col-span-1">
						<span class="mb-1.5 block text-sm font-medium text-ink">{t('contact.form.phone')}</span>
						<input
							type="tel"
							name="phone"
							autocomplete="tel"
							inputmode="tel"
							required
							placeholder={t('contact.form.phonePlaceholder')}
							class="w-full rounded-xl border border-line bg-canvas px-4 py-3 text-ink placeholder:text-ink-subtle transition hover:border-line-strong"
						/>
					</label>

					<label class="block sm:col-span-2">
						<span class="mb-1.5 block text-sm font-medium text-ink">{t('contact.form.message')}</span>
						<textarea
							name="message"
							rows="6"
							required
							placeholder={t('contact.form.messagePlaceholder')}
							class="w-full resize-y rounded-xl border border-line bg-canvas px-4 py-3 text-ink placeholder:text-ink-subtle transition hover:border-line-strong"
						></textarea>
					</label>

					<div class="sm:col-span-2">
						<button
							type="submit"
							class="inline-flex items-center justify-center rounded-xl bg-cta px-6 py-3 text-sm font-semibold text-white transition hover:bg-cta-hover"
						>
							{t('contact.form.submit')}
						</button>
					</div>
				</form>
			</section>
		</div>
	</main>
</Layout>

<script>
	const form = document.getElementById('contact-form');
	if (form instanceof HTMLFormElement) {
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const email = form.dataset.email;
			const subject = form.dataset.subject ?? '';
			if (!email) return;

			const data = new FormData(form);
			const name = String(data.get('name') ?? '').trim();
			const from = String(data.get('email') ?? '').trim();
			const phone = String(data.get('phone') ?? '').trim();
			const message = String(data.get('message') ?? '').trim();

			const labelName = form.dataset.labelName ?? 'Name';
			const labelEmail = form.dataset.labelEmail ?? 'Email';
			const labelPhone = form.dataset.labelPhone ?? 'Phone';
			const body = [`${labelName}: ${name}`, `${labelEmail}: ${from}`, `${labelPhone}: ${phone}`, '', message].join(
				'\n',
			);
			const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			window.location.href = mailto;
		});
	}
</script>
