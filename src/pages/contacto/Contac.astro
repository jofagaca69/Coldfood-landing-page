---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import FormNotice from '@/components/FormNotice.astro';
import ctaImage from '@/assets/contacto/contacto.jpg';
import politicadeDatos from '@/assets/docs/Politicadedatos.pdf?url';
import { CONTACT, CONTACT_LINES, getWhatsAppUrl } from '@/data/contact';
import { resolveLocale, useTranslations } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';

const whatsappHref = getWhatsAppUrl(t('contact.whatsapp.prefill'));

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(`${CONTACT.address.street}, ${CONTACT.address.city}, ${CONTACT.address.country}`)}&z=15&output=embed`;

const infoItems = [
	...CONTACT_LINES.map((line) => ({
		href: getWhatsAppUrl(t('contact.whatsapp.prefill'), line.number),
		external: true,
		title: `${t('contact.whatsapp.title')} · ${t(line.labelKey)}`,
		meta: line.display,
		icon: 'whatsapp' as const,
	})),
	...CONTACT_LINES.map((line) => ({
		href: `mailto:${line.email}`,
		external: false,
		title: `${t('contact.info.email')} · ${t(line.labelKey)}`,
		meta: line.email,
		icon: 'email' as const,
	})),
];

const inputClass =
	'w-full rounded-lg border border-white/25 bg-white/10 px-4 py-3 text-white placeholder:text-white/55 transition hover:border-white/45 focus-visible:outline-white';
---

<Layout title={t('contact.seoTitle')} description={t('contact.seoDescription')}>
	<main>
		<section class="mx-auto max-w-6xl px-4 pt-12 pb-6 sm:px-6 sm:pt-16 lg:px-8">
			<h1 class="max-w-2xl font-display text-4xl leading-[1.08] font-bold text-ink sm:text-5xl">
				{t('contact.title')}
			</h1>
			<p class="mt-4 max-w-[58ch] text-base text-ink-muted sm:text-lg">
				{t('contact.subtitle')}
			</p>
		</section>

		<section class="bg-canvas">
			<div class="mx-auto grid max-w-6xl gap-10 px-4 pt-2 pb-14 sm:px-6 lg:grid-cols-2 lg:items-start lg:gap-14 lg:px-8 lg:pt-4 lg:pb-20">
				<div class="rounded-2xl bg-primary p-6 text-white shadow-sm sm:p-8">
					<p class="text-sm font-medium text-white/75">{t('contact.form.kicker')}</p>
					<h2 class="mt-1 text-3xl font-bold tracking-tight">{t('contact.form.title')}</h2>

					<form
						id="contact-form"
						class="mt-8 grid gap-4"
						action="https://api.web3forms.com/submit"
						method="POST"
						data-web3forms
						data-sending={t('form.sending')}
						data-error={t('form.error')}
						data-configuration-error={t('form.configurationError')}
					>
						<input type="hidden" name="access_key" value={web3FormsAccessKey} />
						<input type="hidden" name="subject" value={t('contact.form.subject')} />
						<input type="hidden" name="from_name" value="Coldfood · Contacto web" />
						<input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

						<label class="block">
							<span class="mb-1.5 block text-sm font-medium">{t('contact.form.name')}</span>
							<input
								type="text"
								name="name"
								autocomplete="name"
								required
								placeholder={t('contact.form.namePlaceholder')}
								class={inputClass}
							/>
						</label>

						<label class="block">
							<span class="mb-1.5 block text-sm font-medium">{t('contact.form.email')}</span>
							<input
								type="email"
								name="email"
								autocomplete="email"
								required
								placeholder={t('contact.form.emailPlaceholder')}
								class={inputClass}
							/>
						</label>

						<label class="block">
							<span class="mb-1.5 block text-sm font-medium">{t('contact.form.message')}</span>
							<textarea
								name="message"
								rows="5"
								required
								placeholder={t('contact.form.messagePlaceholder')}
								class:list={[inputClass, 'resize-y']}
							></textarea>
						</label>

						<label class="mt-1 flex items-start gap-3 text-sm leading-snug text-white/90">
							<input
								type="checkbox"
								name="privacy"
								required
								class="mt-0.5 h-4 w-4 shrink-0 rounded border-white/45 bg-white/10 accent-white"
							/>
							<span>
								{t('contact.form.privacyPrefix')}
								<a
									href={politicadeDatos}
									data-privacy-link
									target="_blank"
									rel="noopener noreferrer"
									class="underline underline-offset-2 hover:text-white"
								>
									{t('contact.form.privacyLink')}
								</a>
								{t('contact.form.privacySuffix')}
							</span>
						</label>

						<button
							type="submit"
							class="mt-2 inline-flex w-full items-center justify-center rounded-full bg-surface px-6 py-3 text-sm font-semibold text-primary transition hover:bg-canvas disabled:cursor-wait disabled:opacity-65"
						>
							{t('contact.form.submit')}
						</button>
						<p data-form-status hidden role="alert" class="text-center text-sm font-medium text-white"></p>
					</form>
				</div>

				<div>
					<ul class="grid gap-8 sm:grid-cols-2">
						{
							infoItems.map((item) => (
								<li class:list={[item.icon === 'email' && 'sm:col-span-2']}>
									<a
										href={item.href}
										target={item.external ? '_blank' : undefined}
										rel={item.external ? 'noopener noreferrer' : undefined}
										class="group flex gap-4"
									>
										<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
											{item.icon === 'email' && (
												<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
													<rect x="3.75" y="5.75" width="16.5" height="12.5" rx="1.75" stroke="currentColor" stroke-width="1.75" />
													<path
														d="m4.5 7.5 7.5 5.25L19.5 7.5"
														stroke="currentColor"
														stroke-width="1.75"
														stroke-linecap="round"
														stroke-linejoin="round"
													/>
												</svg>
											)}
											{item.icon === 'whatsapp' && (
												<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
													<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
												</svg>
											)}
										</span>
										<span class="min-w-0">
											<span class="block text-sm font-semibold text-ink group-hover:text-primary">{item.title}</span>
											<span class="mt-1 block text-sm whitespace-nowrap text-ink-muted">{item.meta}</span>
										</span>
									</a>
								</li>
							))
						}
					</ul>

					<div class="mt-8 overflow-hidden rounded-xl border border-line">
						<iframe
							title={t('contact.map')}
							src={mapSrc}
							class="h-56 w-full lg:h-64"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						></iframe>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-canvas pb-16 sm:pb-20">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
				<div class="relative overflow-hidden rounded-2xl">
					<Image
						src={ctaImage}
						alt=""
						class="absolute inset-0 h-full w-full object-cover"
						widths={[800, 1280, 1920]}
						sizes="(min-width: 72rem) 72rem, 100vw"
					/>
					<div class="absolute inset-0 bg-linear-to-b from-ink/20 via-ink/30 to-ink/40" aria-hidden="true"></div>
					<div class="relative px-6 py-14 text-center sm:px-10 sm:py-16">
						<p class="text-sm font-semibold tracking-[0.2em] text-white uppercase">{t('contact.banner.kicker')}</p>
						<h2 class="mx-auto mt-3 max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl">{t('contact.banner.title')}</h2>
						<a
							href={whatsappHref}
							target="_blank"
							rel="noopener noreferrer"
							class="mt-8 inline-flex items-center justify-center rounded-full bg-cta px-6 py-3 text-sm font-semibold text-white transition hover:bg-cta-hover"
						>
							{t('contact.banner.cta')}
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<FormNotice />
</Layout>

<script>
	import '@/scripts/web3forms';
</script>
