---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import factoryImage from '@/assets/conocenos/conocenos1.png';
import originImage from '@/assets/conocenos/conocenos2.png';
import fieldImage from '@/assets/conocenos/conocenos3.png';
import invimaImage from '@/assets/invima.png';
import fdaImage from '@/assets/FDA.png';
import { resolveLocale, useTranslations, getLocalizedPath } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const contactPath = getLocalizedPath('/contacto/', locale);

const stats = [
	{
		value: '11',
		label: t('about.stats.years'),
		icon: 'M7 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm6.5-1a2.5 2.5 0 1 0 0-5M2 17c0-3 2-5 5-5s5 2 5 5m0-5c3 0 5 1.8 5 4.5',
	},
	{ value: '47', label: t('about.stats.products'), icon: 'm4 6 6-3 6 3-6 3-6-3Zm0 0v8l6 3 6-3V6M10 9v8' },
	{ value: '8', label: t('about.stats.categories'), icon: 'M10 2.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Zm0 0c2 2 3 4.5 3 7.5s-1 5.5-3 7.5m0-15C8 4.5 7 7 7 10s1 5.5 3 7.5M2.5 10h15' },
	{
		value: '−18 °C',
		label: t('about.stats.temp'),
		icon: 'M10 2v16M10 2 6.5 5.5M10 2l3.5 3.5M10 18l-3.5-3.5M10 18l3.5-3.5M2 10h16M2 10l3.5-3.5M2 10l3.5 3.5M18 10l-3.5-3.5M18 10l-3.5 3.5',
	},
];

const values = [
	{
		title: t('about.values.origin.title'),
		body: t('about.values.origin.body'),
		icon: 'M5 17c7-1.5 11-7 12-14C10 5 5.5 9 5 17Zm2-3c2-2 5-4 9-6',
	},
	{
		title: t('about.values.cold.title'),
		body: t('about.values.cold.body'),
		icon: 'M8 3a2 2 0 0 1 4 0v7.2a4 4 0 1 1-4 0V3Zm2 2v7M15 5l2-1M15 9h2.5M5 5 3 4M5 9H2.5',
	},
	{
		title: t('about.values.reach.title'),
		body: t('about.values.reach.body'),
		icon: 'M10 2.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Zm0 0c2 2 3 4.5 3 7.5s-1 5.5-3 7.5m0-15C8 4.5 7 7 7 10s1 5.5 3 7.5M2.5 10h15',
	},
];

const processSteps = [
	{ title: t('about.process.step1.title'), body: t('about.process.step1.body') },
	{ title: t('about.process.step2.title'), body: t('about.process.step2.body') },
	{ title: t('about.process.step3.title'), body: t('about.process.step3.body') },
	{ title: t('about.process.step4.title'), body: t('about.process.step4.body') },
	{ title: t('about.process.step5.title'), body: t('about.process.step5.body') },
	{ title: t('about.process.step6.title'), body: t('about.process.step6.body') },
];
---

<Layout title={t('about.seoTitle')} description={t('about.seoDescription')} aboutPage>
	<main class="bg-canvas">
		<section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 sm:pt-14 lg:px-8">
			<div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
				<div>
					<div class="flex items-center gap-4">
						<p class="text-xs font-semibold tracking-[0.2em] text-primary uppercase">{t('about.kicker')}</p>
						<span class="h-px w-16 bg-line-strong" aria-hidden="true"></span>
					</div>
					<h1 class="mt-5 font-display text-[2rem] leading-[1.05] font-bold text-ink sm:text-5xl lg:text-[3.5rem]">
						<span class="block whitespace-nowrap">{t('about.title.a')}</span>
						<span class="block">{t('about.title.b')}</span>
					</h1>
					<p class="mt-6 max-w-[52ch] text-sm leading-relaxed text-ink-muted sm:text-base">{t('about.lead')}</p>
					<p class="mt-4 max-w-[52ch] text-sm leading-relaxed text-ink-muted sm:text-base">{t('about.lead2')}</p>
				</div>

				<div class="overflow-hidden rounded-[6rem_1rem_6rem_1rem] bg-surface">
					<Image
						src={factoryImage}
						alt={t('about.imageAlt')}
						widths={[640, 960, 1280]}
						sizes="(min-width: 64rem) 34rem, 100vw"
						loading="eager"
						class="aspect-square h-full w-full object-cover object-center"
					/>
				</div>
			</div>

			<ul class="mt-8 grid grid-cols-2 border-y border-line py-7 sm:grid-cols-4">
				{
					stats.map((item, index) => (
						<li class:list={['px-3 text-center sm:px-5', index > 0 && 'sm:border-l sm:border-line', index % 2 === 1 && 'border-l border-line']}>
							<span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary">
								<svg class="h-7 w-7" viewBox="0 0 20 20" fill="none" aria-hidden="true">
									<path d={item.icon} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
							<p class="mt-3 font-display text-3xl leading-none font-bold text-ink sm:text-4xl">{item.value}</p>
							<p class="mt-2 text-[10px] font-semibold tracking-[0.12em] text-ink-muted uppercase sm:text-xs">{item.label}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mx-auto grid max-w-6xl items-stretch gap-8 px-4 py-12 sm:px-6 md:grid-cols-[1.05fr_0.95fr] md:gap-10 lg:px-8 lg:py-14">
			<div class="overflow-hidden rounded-2xl">
				<Image
					src={originImage}
					alt={t('about.colombia.imageAlt')}
					widths={[640, 960, 1280]}
					sizes="(min-width: 48rem) 50vw, 100vw"
					class="h-full min-h-80 w-full object-cover object-center"
				/>
			</div>
			<div>
				<p class="text-xs font-semibold tracking-[0.2em] text-primary uppercase">{t('about.story.kicker')}</p>
				<h2 class="mt-4 max-w-[18ch] font-display text-3xl leading-[1.1] font-semibold text-ink sm:text-4xl">
					{t('about.story.title')}
				</h2>
				<p class="mt-5 max-w-[54ch] text-base leading-relaxed text-ink-muted">{t('about.story.body')}</p>
				<p class="mt-4 max-w-[54ch] text-base leading-relaxed text-ink-muted">{t('about.story.body2')}</p>
				<p class="mt-6 border-t border-line pt-4 text-xs font-semibold tracking-[0.18em] text-primary uppercase">
					{t('about.story.tagline')}
				</p>
			</div>
		</section>

		<section class="border-y border-line bg-surface">
			<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
				<div class="flex items-center gap-4">
					<p class="text-xs font-semibold tracking-[0.2em] text-primary uppercase">{t('about.values.kicker')}</p>
					<span class="h-px flex-1 bg-line" aria-hidden="true"></span>
				</div>
				<ul class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-0">
					{
						values.map((item, index) => (
							<li class:list={['sm:px-7', index === 0 ? 'sm:pl-0' : 'sm:border-l sm:border-line', index === values.length - 1 && 'sm:pr-0']}>
								<span class="flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary">
									<svg class="h-8 w-8" viewBox="0 0 20 20" fill="none" aria-hidden="true">
										<path d={item.icon} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
								<h3 class="mt-4 text-xl font-semibold text-ink">{item.title}</h3>
								<p class="mt-3 text-sm leading-relaxed text-ink-muted">{item.body}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="border-y border-line bg-surface">
			<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
				<div class="flex items-center gap-4">
					<p class="text-xs font-semibold tracking-[0.2em] text-primary uppercase">{t('about.process.kicker')}</p>
					<span class="h-px flex-1 bg-line" aria-hidden="true"></span>
				</div>
				<h2 class="mt-4 max-w-2xl font-display text-3xl leading-[1.12] font-semibold text-ink sm:text-4xl">
					{t('about.process.title')}
				</h2>
				<ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{
						processSteps.map((step, index) => (
							<li class="rounded-2xl border border-line bg-canvas p-5">
								<span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">
									{index + 1}
								</span>
								<h3 class="mt-3 text-base font-semibold text-ink">{step.title}</h3>
								<p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{step.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="border-b border-line bg-canvas">
			<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
				<p class="text-xs font-semibold tracking-[0.2em] text-primary uppercase">{t('about.export.kicker')}</p>
				<h2 class="mt-4 max-w-2xl font-display text-3xl leading-[1.12] font-semibold text-ink sm:text-4xl">
					{t('about.export.title')}
				</h2>
				<p class="mt-4 max-w-[60ch] text-base leading-relaxed text-ink-muted sm:text-lg">{t('about.export.body')}</p>
			</div>
		</section>

		<section class="border-b border-line bg-canvas">
			<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
				<div class="flex items-center gap-4">
					<p class="text-xs font-semibold tracking-[0.2em] text-primary uppercase">{t('about.certifications.kicker')}</p>
					<span class="h-px flex-1 bg-line" aria-hidden="true"></span>
				</div>
				<h2 class="mt-4 max-w-2xl font-display text-3xl leading-[1.12] font-semibold text-ink sm:text-4xl">
					{t('about.certifications.title')}
				</h2>

				<div class="mt-8 grid gap-6 md:grid-cols-2">
					<article class="grid items-center gap-6 rounded-2xl border border-line bg-surface p-6 shadow-sm sm:grid-cols-[10rem_1fr] sm:p-8">
						<div class="relative mx-auto h-32 w-full max-w-64 overflow-hidden rounded-xl bg-white sm:flex sm:h-40 sm:max-w-none sm:items-center sm:justify-center sm:overflow-visible sm:p-4">
							<Image
								src={invimaImage}
								alt={t('about.certifications.invima.imageAlt')}
								width={252}
								class="absolute top-1/2 left-1/2 w-64 max-w-none -translate-x-1/2 -translate-y-1/2 object-contain sm:static sm:h-auto sm:w-full sm:max-w-full sm:translate-x-0 sm:translate-y-0"
							/>
						</div>
						<div class="text-center sm:text-left">
							<h3 class="font-display text-2xl font-semibold text-ink">{t('about.certifications.invima.title')}</h3>
							<p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">{t('about.certifications.invima.body')}</p>
						</div>
					</article>

					<article class="grid items-center gap-6 rounded-2xl border border-line bg-surface p-6 shadow-sm sm:grid-cols-[10rem_1fr] sm:p-8">
						<div class="mx-auto flex h-32 w-full max-w-64 items-center justify-center rounded-xl bg-white p-3 sm:h-40 sm:max-w-none sm:p-4">
							<Image
								src={fdaImage}
								alt={t('about.certifications.fda.imageAlt')}
								width={252}
								class="h-28 w-28 object-contain sm:h-32 sm:w-32"
							/>
						</div>
						<div class="text-center sm:text-left">
							<h3 class="font-display text-2xl font-semibold text-ink">{t('about.certifications.fda.title')}</h3>
							<p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">{t('about.certifications.fda.body')}</p>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8">
			<div class="relative overflow-hidden sm:aspect-[1024/330]">
				<Image
					src={fieldImage}
					alt=""
					widths={[640, 960, 1280, 1600]}
					sizes="(min-width: 64rem) 72rem, 100vw"
					class="relative h-auto w-full object-contain sm:absolute sm:inset-0 sm:h-full"
				/>
				<div class="relative max-w-lg px-2 pt-6 pb-2 sm:flex sm:h-full sm:flex-col sm:justify-start sm:px-10 sm:pt-20 sm:pb-8 lg:px-14 lg:pt-24">
					<h2 class="font-display text-2xl font-bold text-ink sm:text-3xl sm:whitespace-nowrap">{t('about.cta.title')}</h2>
					<p class="mt-2 max-w-[46ch] text-sm font-medium text-ink sm:text-base">{t('about.cta.body')}</p>
					<a
						href={contactPath}
						class="mt-4 inline-flex w-fit items-center justify-center rounded-full bg-primary px-4 py-2 text-xs font-semibold text-white hover:bg-primary-hover sm:text-sm"
					>
						{t('about.cta.contact')}
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
