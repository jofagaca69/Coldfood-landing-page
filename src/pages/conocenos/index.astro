---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import coldfoodImage from '@/assets/coldfood.png';
import colombiaImage from '@/assets/colombia.png';
import { CATEGORIES } from '@/data/categories';
import { PRODUCTS } from '@/data/products';
import { resolveLocale, useTranslations, getLocalizedPath } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const productsPath = getLocalizedPath('/productos/', locale);
const contactPath = getLocalizedPath('/contacto/', locale);

const stats = [
	{ value: '+11', label: t('about.stats.years') },
	{ value: String(PRODUCTS.length), label: t('about.stats.products') },
	{ value: String(CATEGORIES.length), label: t('about.stats.categories') },
	{ value: '−18 °C', label: t('about.stats.temp') },
];

const values = [
	{ index: '01', title: t('about.values.origin.title'), body: t('about.values.origin.body') },
	{ index: '02', title: t('about.values.cold.title'), body: t('about.values.cold.body') },
	{ index: '03', title: t('about.values.reach.title'), body: t('about.values.reach.body') },
];
---

<Layout title={t('about.seoTitle')} description={t('about.seoDescription')}>
	<main>
		<section class="mx-auto max-w-6xl px-4 pt-12 pb-8 sm:px-6 sm:pt-16 lg:px-8">
				<h1 class="max-w-3xl font-display text-4xl leading-[1.08] font-bold text-ink sm:text-5xl">
					{t('about.title.a')} {t('about.title.b')}
				</h1>
				<p class="mt-4 max-w-[62ch] text-base leading-relaxed text-ink-muted sm:text-lg">
					{t('about.lead')}
				</p>
		</section>

		<section class="bg-canvas pb-14 sm:pb-16">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
				<div class="mx-auto grid max-w-5xl overflow-hidden rounded-2xl border border-line bg-surface shadow-sm lg:grid-cols-[0.9fr_1.1fr]">
					<Image
						src={coldfoodImage}
						alt={t('about.imageAlt')}
						widths={[640, 960, 1440]}
						sizes="(min-width: 64rem) 36rem, 100vw"
						loading="eager"
						class="h-full min-h-60 w-full bg-surface object-contain p-8 sm:p-10"
					/>
					<div class="flex flex-col justify-center p-6 sm:p-7 lg:p-8">
						<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase">{t('about.story.kicker')}</p>
						<h2 class="mt-3 font-display text-2xl leading-[1.12] font-semibold text-ink sm:text-3xl">
							{t('about.story.title')}
						</h2>
						<p class="mt-4 text-sm leading-relaxed text-ink-muted sm:text-base">{t('about.story.body')}</p>
					</div>
				</div>

				<dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8 border-y border-line py-8 sm:grid-cols-4">
					{
						stats.map((item) => (
							<div>
								<dt class="text-xs font-semibold tracking-[0.16em] text-ink-muted uppercase">{item.label}</dt>
								<dd class="mt-2 font-display text-3xl leading-none font-bold text-ink sm:text-4xl">{item.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<section class="border-t border-line bg-canvas">
			<div class="mx-auto grid max-w-5xl items-center gap-8 px-4 py-14 sm:px-6 md:grid-cols-[0.65fr_1.35fr] md:gap-12 lg:px-8 lg:py-16">
				<div class="flex justify-center rounded-2xl border border-line bg-surface p-6 shadow-sm">
					<Image
						src={colombiaImage}
						alt={t('about.colombia.imageAlt')}
						widths={[240, 360, 480]}
						sizes="(min-width: 48rem) 16rem, 70vw"
						class="h-auto max-h-72 w-auto"
					/>
				</div>
				<div>
					<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase">{t('about.colombia.kicker')}</p>
					<h2 class="mt-3 font-display text-3xl leading-[1.12] font-semibold text-ink sm:text-4xl">
						{t('about.colombia.title')}
					</h2>
					<p class="mt-5 max-w-[54ch] text-base leading-relaxed text-ink-muted sm:text-lg">
						{t('about.colombia.body')}
					</p>
				</div>
			</div>
		</section>

		<section class="border-t border-line bg-surface-muted/40">
			<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
				<p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase">{t('about.values.kicker')}</p>
				<h2 class="mt-3 max-w-2xl font-display text-3xl leading-[1.12] font-semibold text-ink sm:text-4xl">
					{t('about.values.title')}
				</h2>
				<ul class="mt-8 grid gap-5 sm:grid-cols-3">
					{
						values.map((item) => (
							<li class="rounded-2xl border border-line bg-surface p-6 shadow-sm">
								<p class="text-xs font-semibold tracking-[0.18em] text-primary">{item.index}</p>
								<h3 class="mt-3 text-xl font-semibold text-ink">{item.title}</h3>
								<p class="mt-3 text-sm leading-relaxed text-ink-muted">{item.body}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="border-t border-line bg-canvas">
			<div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-14 lg:px-8">
				<div>
					<h2 class="font-display text-3xl font-semibold text-ink sm:text-4xl">{t('about.cta.title')}</h2>
					<p class="mt-2 text-ink-muted">{t('about.cta.body')}</p>
				</div>
				<div class="flex flex-wrap items-center gap-3">
					<a
						href={productsPath}
						class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-hover"
					>
						{t('about.cta.products')}
					</a>
					<a href={contactPath} class="inline-flex items-center gap-2 px-2 py-2.5 text-sm font-semibold text-primary hover:underline">
						{t('about.cta.contact')}
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
