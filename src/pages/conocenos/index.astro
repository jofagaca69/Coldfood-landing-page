---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import plantImage from '@/assets/contacto/contacto2.jpg';
import { SITE } from '@/consts';
import { CATEGORIES } from '@/data/categories';
import { PRODUCTS } from '@/data/products';
import { resolveLocale, useTranslations, getLocalizedPath } from '@/i18n/utils';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const homePath = getLocalizedPath('/', locale);
const productsPath = getLocalizedPath('/productos/', locale);
const contactPath = getLocalizedPath('/contacto/', locale);

const stats = [
	{ value: '11', label: t('about.stats.years') },
	{ value: String(PRODUCTS.length), label: t('about.stats.products') },
	{ value: String(CATEGORIES.length), label: t('about.stats.categories') },
	{ value: '−18 °C', label: t('about.stats.temp') },
];

const values = [
	{ index: '01', title: t('about.values.origin.title'), body: t('about.values.origin.body') },
	{ index: '02', title: t('about.values.cold.title'), body: t('about.values.cold.body') },
	{ index: '03', title: t('about.values.reach.title'), body: t('about.values.reach.body') },
];
---

<Layout title={t('about.seoTitle')} description={t('about.seoDescription')}>
	<main>
		<section class="bg-canvas">
			<div class="mx-auto max-w-4xl px-4 pt-16 pb-12 sm:px-6 sm:pt-20 lg:px-8 lg:pt-24">
				<p class="text-xs text-ink-muted">
					<a href={homePath} class="hover:text-primary">{t('nav.home')}</a>
					<span class="mx-2" aria-hidden="true">/</span>
					<span class="text-ink">{t('nav.about')}</span>
				</p>

				<p class="mt-10 text-xs font-semibold tracking-[0.2em] text-primary uppercase">{t('about.kicker')}</p>
				<h1 class="mt-4 font-display text-4xl leading-[1.08] font-bold tracking-tight text-ink sm:text-5xl lg:text-[3.5rem]">
					<span class="block">{t('about.title.a')}</span>
					<span class="block">{t('about.title.b')}</span>
				</h1>
				<p class="mt-8 max-w-[42ch] text-lg leading-relaxed text-ink-muted sm:text-xl">
					{t('about.lead')}
				</p>
			</div>
		</section>

		<section class="bg-canvas">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
				<Image
					src={plantImage}
					alt={t('about.imageAlt')}
					widths={[960, 1440, 1920]}
					sizes="(min-width: 72rem) 72rem, 100vw"
					loading="eager"
					class="aspect-[21/9] w-full rounded-2xl object-cover"
				/>
			</div>
		</section>

		<section class="bg-canvas">
			<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
				<dl class="grid grid-cols-2 gap-x-6 gap-y-10 border-y border-line py-10 sm:grid-cols-4 sm:py-12">
					{
						stats.map((item) => (
							<div>
								<dt class="text-xs font-semibold tracking-[0.16em] text-ink-muted uppercase">{item.label}</dt>
								<dd class="mt-2 font-display text-3xl leading-none font-bold text-ink sm:text-4xl">{item.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<section class="bg-canvas">
			<div class="mx-auto grid max-w-6xl gap-10 px-4 pb-16 sm:px-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20 lg:px-8 lg:pb-24">
				<div>
					<p class="text-xs font-semibold tracking-[0.2em] text-primary uppercase">{t('about.story.kicker')}</p>
					<h2 class="mt-3 max-w-[16ch] font-display text-3xl leading-[1.12] font-semibold text-ink sm:text-4xl">
						{t('about.story.title')}
					</h2>
				</div>
				<div>
					<p class="max-w-[54ch] text-base leading-relaxed text-ink-muted sm:text-lg">{t('about.story.body')}</p>
					<p class="mt-6 text-sm text-ink">{SITE.legalName}</p>
				</div>
			</div>
		</section>

		<section class="border-t border-line bg-canvas">
			<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
				<p class="text-xs font-semibold tracking-[0.2em] text-primary uppercase">{t('about.values.kicker')}</p>
				<ul class="mt-10 grid gap-12 sm:grid-cols-3 sm:gap-10">
					{
						values.map((item) => (
							<li class="border-t border-line pt-6">
								<p class="text-xs tracking-[0.18em] text-ink-subtle">{item.index}</p>
								<h3 class="mt-3 font-display text-2xl font-semibold text-ink">{item.title}</h3>
								<p class="mt-3 max-w-[32ch] text-sm leading-relaxed text-ink-muted">{item.body}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="border-t border-line bg-canvas">
			<div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 sm:flex-row sm:items-end sm:justify-between sm:px-6 sm:py-16 lg:px-8">
				<div>
					<h2 class="font-display text-3xl font-semibold text-ink sm:text-4xl">{t('about.cta.title')}</h2>
					<p class="mt-2 text-ink-muted">{t('about.cta.body')}</p>
				</div>
				<div class="flex flex-wrap items-center gap-3">
					<a
						href={productsPath}
						class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-hover"
					>
						{t('about.cta.products')}
					</a>
					<a href={contactPath} class="inline-flex items-center gap-2 px-2 py-2.5 text-sm font-semibold text-primary hover:underline">
						{t('about.cta.contact')}
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
