---
import Layout from '@/layouts/Layout.astro';
import { CATEGORIES } from '@/data/categories';
---

<Layout title="Products | Coldfood" description="Coldfood product catalog by category.">
	<main class="mx-auto max-w-5xl px-4 py-16">
		<h1 class="text-center text-3xl font-bold text-primary sm:text-5xl">Products</h1>
		<p class="mt-4 text-center text-ink-muted">Content coming soon.</p>

		<div class="mt-16 space-y-24">
			{
				CATEGORIES.map((cat) => (
					<section id={cat.slug} class="scroll-mt-24 border-t border-line pt-10">
						<h2 class="text-2xl font-semibold text-ink">{cat.en}</h2>
						<p class="mt-2 text-ink-muted">Content coming soon.</p>
					</section>
				))
			}
		</div>
	</main>
</Layout>
