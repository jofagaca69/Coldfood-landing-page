---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import SEO from '@/components/SEO.astro';
import JsonLd from '@/components/JsonLd.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { resolveLocale } from '@/i18n/utils';
import type { Product } from '@/data/products';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	/** Dimensiones reales de `image`, para que og:image:width/height no queden hardcodeadas a 1200x630 cuando la imagen es otro formato (p. ej. el packshot vertical de un producto). */
	imageWidth?: number;
	imageHeight?: number;
	canonical?: string;
	noindex?: boolean;
	/** Ficha de producto (/productos/<slug>/) — agrega un nodo Product al JSON-LD. */
	product?: Product;
	/** Índice de catálogo (/productos/) — agrega un ItemList al JSON-LD. */
	productList?: Product[];
	/** Página de contacto (/contacto/) — agrega un nodo ContactPage al JSON-LD. */
	contactPage?: boolean;
	/** Página "Conócenos" (/conocenos/) — agrega un nodo AboutPage al JSON-LD. */
	aboutPage?: boolean;
}

const { title, description, image, imageWidth, imageHeight, canonical, noindex, product, productList, contactPage, aboutPage } =
	Astro.props;
const locale = resolveLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<SEO
			title={title}
			description={description}
			image={image}
			imageWidth={imageWidth}
			imageHeight={imageHeight}
			canonical={canonical}
			noindex={noindex}
		/>
		<JsonLd product={product} productList={productList} contactPage={contactPage} aboutPage={aboutPage} />

		<Font cssVariable="--font-montserrat" preload />
		<Font cssVariable="--font-satoshi" preload />

		<slot name="head" />
	</head>
	<body class="flex min-h-dvh flex-col">
		<Header />
		<div class="flex-1">
			<slot />
		</div>
		<Footer />
	</body>
</html>
